#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path


def main():
    root = Path(__file__).resolve().parents[1]
    musl = root / "musl" / "musl-1.2.5-install"
    lib = musl / "lib"
    runtime = root / "app" / "usr" / "cxx" / "install"
    args = sys.argv[1:]
    command = ["g++", "-m32", "-march=i686"]
    if args == ["--mario-verify"]:
        return
    if args in (["-dumpmachine"], ["-print-multiarch"]):
        print("i386-linux-musl")
        return
    queries = {"--version", "-v", "--help"}
    if len(args) == 1 and args[0] in queries:
        os.execvp(command[0], command + args)

    use_runtime = "--mario-no-cxx-runtime" not in args
    args = [arg for arg in args if arg != "--mario-no-cxx-runtime"]
    builtin_headers = subprocess.check_output(
        command + ["-print-file-name=include"], text=True
    ).strip()
    for variable in ("CPATH", "C_INCLUDE_PATH", "CPLUS_INCLUDE_PATH"):
        os.environ.pop(variable, None)
    command += ["-nostdinc", "-fno-pic", "-fno-pie", "-fno-stack-protector"]
    if use_runtime:
        headers = runtime / "include" / "c++" / "v1"
        if not (headers / "__config_site").is_file():
            sys.exit("Mario C++ runtime is missing; build it with make app first")
        command += ["-isystem", str(headers), "-fno-exceptions"]
    command += ["-isystem", str(musl / "include"), "-isystem", builtin_headers]
    link = not {"-c", "-E", "-S", "-M", "-MM", "-fsyntax-only"}.intersection(args)
    if link:
        command += ["-static", "-nostdlib", "-fuse-ld=bfd",
                    str(lib / "crt1.o"), str(lib / "crti.o")]
    command += args
    if link:
        command += ["-x", "none", "-Wl,--start-group"]
        if use_runtime:
            command += [str(runtime / "lib" / name) for name in ("libc++.a", "libc++abi.a")]
        command += [
            str(lib / "libc.a"), str(root / "compiler-rt" / "libcompiler_rt.a"),
            "-Wl,--end-group", str(lib / "crtn.o"),
            "-Wl,--orphan-handling=warn,--gc-sections,-T," + str(root / "musl/musl.ld"),
        ]
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
