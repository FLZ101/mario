#!/usr/bin/env python3

import os
import sys
import subprocess

from pathlib import Path

from compile_commands import record_compile_commands


class Unreachable(Exception):
    pass


def get_args():
    cwd = Path(__file__).resolve().parent

    prog_name = os.path.basename(sys.argv[0])
    args = sys.argv[1:]
    compiler_rt = (cwd / ".." / "compiler-rt" / "libcompiler_rt.a").resolve()

    for x in args:
        if x in ["-v", "--version", "-h", "--help"]:
            return ["gcc"] + args

        if x == "--mario-verify":
            sys.exit(0)

        # CPython's cross configure compares $CC's multiarch with its
        # musl-derived platform triplet. Letting host gcc answer here
        # returns i386-linux-gnu and aborts with an internal configure error.
        if x in ["-print-multiarch", "--print-multiarch"]:
            if prog_name == "mario-musl-cc":
                sys.stdout.write("i386-linux-musl\n")
                sys.exit(0)

    preprocess_only = False
    compile_only = False
    link_only = True
    for x in args:
        if x == "-E":
            preprocess_only = True
        if x == "-c":
            compile_only = True
        if x.endswith(".c"):
            link_only = False

    # Put unwind-disabling flags before user arguments so later explicit
    # -funwind-tables options from C++ runtime builds can override them.
    # Placing them in flags (after user arguments) would unconditionally
    # re-disable unwind tables and break exception handling.
    flags_before = [
        "-m32",
        "-march=i686",
        "-fno-unwind-tables",
        "-fno-asynchronous-unwind-tables",
    ]
    flags = [
        "-nostdinc",
        "-ffreestanding",
        "-fno-pic",
        "-static",
    ]
    stack_protector = os.environ.get("STACK_PROTECTOR") == "1"
    match prog_name:
        case "cc":
            flags_before = []
            flags = []

        case "mario-cc":
            flags.append(
                "-fstack-protector-strong"
                if stack_protector
                else "-fno-stack-protector"
            )
            if not compile_only and not preprocess_only:
                flags.extend(["-nostdlib", f"{compiler_rt}"])
            pass

        case "mario-musl-cc":
            flags.append("-fno-stack-protector")
            musl_dir = (cwd / ".." / "musl").resolve()
            libc_dir = (musl_dir / "musl-1.2.5-install").resolve()

            if not link_only:
                inc_dir = libc_dir / "include"
                flags.extend(["-isystem", f"{inc_dir}", "-D_MUSL", "-Wno-parentheses"])

            if not compile_only and not preprocess_only:
                lib_dir = libc_dir / "lib"
                linker_script = musl_dir / "musl.ld"

                flags_before.extend(
                    [
                        "-xnone",  # prevent .o files being treated as source files
                        f'{lib_dir / "crt1.o"}',
                        f'{lib_dir / "crti.o"}',
                    ]
                )
                flags.extend(
                    [
                        "-xnone",  # prevent .o files being treated as source files
                        f"-L{lib_dir}",
                        "-nostdlib",
                        "-lc",
                        "-T",
                        f"{linker_script}",
                        f"{compiler_rt}",
                        f'{lib_dir / "crtn.o"}',
                    ]
                )
                flags.append(
                    ",".join(["-Wl", "--orphan-handling=warn", "--gc-sections"])
                )

        case _:
            raise Unreachable()

    args = ["gcc"] + flags_before + args + flags
    record_compile_commands(args, (".c", ".S"))
    return args


def main():
    args = get_args()
    subprocess.run(args, capture_output=False, check=True)


if __name__ == "__main__":
    main()
