MODEL := $(ROOT)/usr-cxx/system-monitor
MONITOR_OBJECTS := $(addprefix $(BUILD_DIR)/,sampler.o telemetry.o ui.o)
CXXFLAGS += -I$(MODEL)
LDFLAGS += $(MONITOR_OBJECTS)

$(EXE): $(MONITOR_OBJECTS)

$(MONITOR_OBJECTS): $(BUILD_DIR)/%.o: $(MODEL)/%.cpp $(RULES) $(TOOLCHAIN_STAMP)
	mkdir -p "$(@D)"
	cd "$(BUILD_DIR)" && $(CXX) $(CXXFLAGS) -o "$@" "$<"

include $(ROOT)/usr-cxx/font-icons.mk
-include $(MONITOR_OBJECTS:.o=.d)
