+static void fib_header(int ext)
+{
+    printf(_("Kernel IP routing table\n"));
+
+    if (ext == 1)
+        printf(_("Destination     Gateway         Genmask         "
+                 "Flags Metric Ref    Use Iface\n"));
+    if (ext == 2)
+        printf(_("Destination     Gateway         Genmask         "
+                 "Flags   MSS Window  irtt Iface\n"));
+    if (ext >= 3)
+        printf(_("Destination     Gateway         Genmask         "
+                 "Flags Metric Ref    Use Iface    "
+                 "MSS   Window irtt\n"));
+}
+
+#ifdef MARIO_NET_TOOLS
+void mario_fib_header(void)
+{
+    fib_header(1);
+}
+
+void mario_fib_entry(in_addr_t dest, in_addr_t gateway, in_addr_t mask,
+                     const char *iface)
+{
+    char net_addr[INET_ADDRSTRLEN], gate_addr[INET_ADDRSTRLEN], mask_addr[INET_ADDRSTRLEN];
+
+    inet_ntop(AF_INET, &dest, net_addr, sizeof(net_addr));
+    inet_ntop(AF_INET, &gateway, gate_addr, sizeof(gate_addr));
+    inet_ntop(AF_INET, &mask, mask_addr, sizeof(mask_addr));
+    printf("%-15s %-15s %-15s %-5s %-6s %-2s %7s %s\n",
+           net_addr, gate_addr, mask_addr, gateway ? "UG" : "U", "-", "-", "-", iface);
+}
+#else
