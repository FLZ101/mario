+static void
+x_vi_winch(void)
+{
+	const char *p;
+
+	/*
+	 * Recompute the vi editor geometry for the new terminal width and
+	 * repaint the current line immediately, matching edit_reset() but
+	 * preserving the edit buffer and cursor.
+	 */
+	pwidth = promptlen(prompt, &p);
+	prompt_skip = p - prompt;
+	if (pwidth > x_cols - 3 - MIN_EDIT_SPACE) {
+		cur_col = x_cols - 3 - MIN_EDIT_SPACE;
+		prompt_trunc = pwidth - cur_col;
+		pwidth -= prompt_trunc;
+	} else
+		prompt_trunc = 0;
+
+	wbuf_len = x_cols - 3;
+	wbuf[0] = aresize(wbuf[0], wbuf_len, APERM);
+	wbuf[1] = aresize(wbuf[1], wbuf_len, APERM);
+	(void) memset(wbuf[0], ' ', wbuf_len);
+	(void) memset(wbuf[1], ' ', wbuf_len);
+	winwidth = x_cols - pwidth - 3;
+
+	redraw_line(1, 0);
+	refresh_line(0);
+	x_flush();
+}
