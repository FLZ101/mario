+static void
+x_emacs_winch(void)
+{
+	/*
+	 * The width changed while the editor was blocked on input.  Reset the
+	 * horizontal scroll and redraw the line at the new width instead of
+	 * waiting until the next command line.
+	 */
+	xx_cols = x_cols;
+	xbp = xbuf;
+	xlp_valid = false;
+	x_redraw(0);
+	x_flush();
+}
