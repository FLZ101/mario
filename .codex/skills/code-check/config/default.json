{
  "description": "Mario source and test rules for check_code.py and check_kernel_locks.py",
  "generic_lock_pattern": "\\b(?:spin_lock_irqsave|spin_lock|ACQUIRE_LOCK)\\s*\\(",
  "generic_unlock_pattern": "\\b(?:spin_unlock_irqrestore|spin_unlock|RELEASE_LOCK)\\s*\\(",
  "unsafe_checks": [
    {
      "pattern": "\\bmemcpy_(?:tofs|fromfs|fs)\\s*\\(",
      "message": "user-memory copy inside spinlock region"
    },
    {
      "pattern": "\\b(?:get|put)_fs_long\\s*\\(",
      "message": "user-memory access inside spinlock region"
    },
    {
      "pattern": "\\bring_buffer_(?:read|write)\\s*\\([^;]*,\\s*1\\s*\\)",
      "message": "ring_buffer user copy (u=1) inside spinlock region"
    }
  ],
  "locks": [
    {
      "name": "tasklist_lock",
      "lock_pattern": "\\b(?:spin_lock_irqsave|spin_lock|ACQUIRE_LOCK)\\s*\\(\\s*&tasklist_lock\\b",
      "unlock_pattern": "\\b(?:spin_unlock_irqrestore|spin_unlock|RELEASE_LOCK)\\s*\\(\\s*&tasklist_lock\\b"
    },
    {
      "name": "mm_lock",
      "lock_pattern": "\\bmm_lock\\s*\\(|\\b(?:spin_lock_irqsave|spin_lock|ACQUIRE_LOCK)\\s*\\([^;]*->mm_lock\\b",
      "unlock_pattern": "\\bmm_unlock\\s*\\(|\\b(?:spin_unlock_irqrestore|spin_unlock|RELEASE_LOCK)\\s*\\([^;]*->mm_lock\\b"
    }
  ],
  "forbidden_pairs": [
    {
      "before": "tasklist_lock",
      "after": "mm_lock"
    },
    {
      "before": "mm_lock",
      "after": "tasklist_lock"
    }
  ],
  "app_exclude_dir_patterns": [
    "^app/usr/(?:ncurses|oksh|toybox|sbase|ubase|vim|nano|less|readline|zlib|freetype|sqlite|Python|libevent|libpng|tmux|openssl|openssh|curl|wget|net-tools)-",
    "^app/usr-cxx/(?:btop|fltk)-[0-9]",
    "^app/usr/cxx/(?:build|install|downloads|[a-zA-Z0-9_]+-[0-9])",
    "^app/usr/video/(?:build|install|FFmpeg|mpv)"
  ],
  "app_unit_test_prefixes": [
    "app/test/",
    "app/test-cxx/"
  ],
  "gui_test_apps": [
    "/usr/bin/terminal",
    "/usr/bin/filemanager",
    "/usr/bin/system-monitor",
    "/usr/bin/imageviewer",
    "/usr/bin/fltk-editor",
    "fltk-demo.exe",
    "fltk-editor.exe",
    "fltk-filemanager",
    "fltk-system-monitor",
    "fltk-window.exe"
  ],
  "gui_launcher_assets": [
    "desktop-launcher",
    "desktop-appearance-launcher"
  ],
  "gui_test_vt_keys": [
    "f1",
    "f2",
    "f3",
    "f4",
    "f5",
    "f6",
    "f7",
    "f8"
  ]
}
