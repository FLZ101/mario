GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.* /tmp/imageviewer.log /tmp/imageviewer.pid; rm -rf /tmp/imageviewer-nav; mkdir /tmp/imageviewer-nav; cp /usr/share/mario-tests/gui/checker-64.bmp /tmp/imageviewer-nav/a.bmp; cp /usr/share/mario-tests/gui/alpha-128.png /tmp/imageviewer-nav/b.png; printf broken >/tmp/imageviewer-nav/c.png; printf ignored >/tmp/imageviewer-nav/d.txt; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/imageviewer /tmp/imageviewer-nav/a.bmp >/tmp/imageviewer.log 2>&1 & echo $! >/tmp/imageviewer.pid
SERIAL: while ! grep -q 'imageviewer: window ready' /tmp/imageviewer.log; do sleep 1; done
GUI-CHECK-RECT: 160 96 8 8 239 68 68
GUI-SEND-KEY: n
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 224 160 1 1 255 255 255
GUI-SEND-KEY: n
GUI-CHECK-RECT: 224 160 1 1 255 255 255
GUI-SEND-KEY: p
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 160 96 8 8 239 68 68
GUI-SEND-KEYS: meta_l,w
SERIAL: while pgrep imageviewer >/dev/null; do sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
