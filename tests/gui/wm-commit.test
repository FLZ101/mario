GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.*; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
GUI-CHECK-RECT: 32 32 32 32 31 41 51
SERIAL: /usr/bin/test/gui-wm-client.exe --commit-only >/tmp/wm-commit.log 2>&1 & echo $! >/tmp/wm-commit.pid
SERIAL: while ! grep -q 'wm-client: commit ok' /tmp/wm-commit.log; do sleep 1; done
SERIAL-CHECK: wm-client: commit ok
GUI-CHECK-RECT: 64 64 2 2 255 0 0
SERIAL: kill $(cat /tmp/wm-commit.pid); kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
