GUI-VISUAL-TEST:
SERIAL: mkdir -p /usr/share/mario; cp /usr/share/mario-tests/gui/checker-64.bmp /usr/share/mario/wallpaper.png; rm -f /tmp/mario-wm.*; /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done; grep 'wallpaper loaded' /tmp/wallpaper.log
SERIAL-CHECK: wallpaper loaded: /usr/share/mario/wallpaper.png (64x64)
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 239 68 68
GUI-CHECK-RECT: 256 0 8 8 34 197 94
GUI-CHECK-RECT: 0 400 8 8 59 130 246
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; rm -f /tmp/mario-wm.*; MARIO_WALLPAPER= /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done; if ! grep -q 'wallpaper' /tmp/wallpaper.log; then echo wallpaper: disabled; fi
SERIAL-CHECK: wallpaper: disabled
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 31 41 51
GUI-CHECK-RECT: 0 752 8 8 17 24 39
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; printf 'not an image' >/usr/share/mario/wallpaper.png; rm -f /tmp/mario-wm.*; /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done; grep 'wallpaper unavailable' /tmp/wallpaper.log
SERIAL-CHECK: wallpaper unavailable: /usr/share/mario/wallpaper.png:
SERIAL-CHECK: using solid background
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 31 41 51
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; rm -f /tmp/mario-wm.*; MARIO_WALLPAPER=/tmp/wallpaper.missing /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done; grep 'wallpaper unavailable' /tmp/wallpaper.log
SERIAL-CHECK: wallpaper unavailable: /tmp/wallpaper.missing:
SERIAL-CHECK: using solid background
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 31 41 51
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; rm -f /usr/share/mario/wallpaper.png
EXIT:
