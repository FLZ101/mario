GUI-VISUAL-TEST:
TIMEOUT: 12
SERIAL: /usr/bin/mario-wm --diagnostics >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: for attempt in 1 2 3 4 5; do grep -q 'private connection ready' /tmp/mario-wm.log && break; sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
SERIAL: (/usr/bin/test/fltk-system-monitor.exe fixture; echo $? >/tmp/monitor-exit) >/tmp/monitor.log 2>&1 &
SERIAL: <<MONITOR
cat >/tmp/monitor-helpers <<'HELPERS'
await_phase() {
    for attempt in 1 2 3 4 5; do
        grep -q "phase=$1\$" /tmp/monitor.log && { printf 'monitor fixture phase=%s accepted\n' "$1"; return; }
        sleep 1
    done
    cat /tmp/monitor.log
}
HELPERS
MONITOR
SERIAL: . /tmp/monitor-helpers; await_phase 0
SERIAL-CHECK: monitor fixture phase=0 accepted
# Pause automatic sampling, publish new counters, and refresh exactly once.
GUI-MOUSE-POSITION: 755,98
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
SERIAL: echo 1 >/tmp/monitor-phase
GUI-MOUSE-POSITION: 870,98
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
SERIAL: await_phase 1
SERIAL-CHECK: monitor fixture phase=1 accepted
# The latest CPU sample is 75% aggregate, 50% CPU 0, and 100% CPU 1.
GUI-CHECK-RECT: 886 232 3 3 50 109 181
GUI-CHECK-RECT: 886 209 3 3 232 237 244
GUI-CHECK-RECT: 886 305 3 3 50 109 181
GUI-CHECK-RECT: 886 340 3 3 50 109 181
GUI-CHECK-RECT: 886 461 3 3 29 128 113
GUI-CHECK-RECT: 886 449 3 1 135 79 160
# PID 11 starts in the first row. Sorting by name moves the selection to row two.
GUI-MOUSE-POSITION: 229,137
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
GUI-MOUSE-POSITION: 280,230
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 365 225 8 8 188 217 251
GUI-MOUSE-POSITION: 278,205
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 365 225 8 8 255 255 255
GUI-CHECK-RECT: 365 250 8 8 188 217 251
# Filtering temporarily moves the same selection to row one.
GUI-MOUSE-POSITION: 205,171
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
GUI-SEND-KEY: z
GUI-CHECK-RECT: 365 225 8 8 188 217 251
GUI-SEND-KEY: backspace
GUI-CHECK-RECT: 365 250 8 8 188 217 251
# Refresh once with the same identity, then again after a different task reuses PID 11.
SERIAL: echo 2 >/tmp/monitor-phase
GUI-MOUSE-POSITION: 870,98
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
SERIAL: await_phase 2
SERIAL-CHECK: monitor fixture phase=2 accepted
GUI-CHECK-RECT: 365 250 8 8 188 217 251
SERIAL: echo 3 >/tmp/monitor-phase
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
SERIAL: await_phase 3
SERIAL-CHECK: monitor fixture phase=3 accepted
GUI-CHECK-RECT: 365 225 8 8 255 255 255
GUI-CHECK-RECT: 365 250 8 8 246 248 251
GUI-MOUSE-POSITION: 323,137
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 650 219 8 5 29 128 113
GUI-CHECK-RECT: 870 219 8 5 232 237 244
GUI-SEND-KEYS: meta_l,w
SERIAL-WAIT-FILE: /tmp/monitor-exit
SERIAL: printf 'monitor fixture exit=%s\n' "$(cat /tmp/monitor-exit)"; kill -TERM $(cat /tmp/mario-wm.pid)
SERIAL-CHECK: monitor fixture exit=0
EXIT:
