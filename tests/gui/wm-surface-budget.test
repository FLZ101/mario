GUI-VISUAL-TEST:
TIMEOUT: 120
SERIAL: rm -f /tmp/mario-wm.* /tmp/gui-budget.* /tmp/gb*; /usr/bin/mario-wm >>/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while test -e /tmp/mario-wm.started && ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done; cat /tmp/mario-wm.log
SERIAL-CHECK: mario-desktop: private connection ready
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
SERIAL: /usr/bin/terminal --command 'printf "budget initial\n"; while test ! -e /tmp/gbpaint; do sleep 1; done; printf "budget pressure\n"; touch /tmp/gbready; read value; touch /tmp/gbtyped; sleep 60' >/tmp/gui-budget.terminal.log 2>&1 & echo $! >/tmp/gui-budget.terminal.pid
SERIAL: while ! grep -q 'terminal: window ready' /tmp/gui-budget.terminal.log && kill -0 $(cat /tmp/gui-budget.terminal.pid) 2>/dev/null; do sleep 1; done; cat /tmp/gui-budget.terminal.log
SERIAL-CHECK: terminal: window ready
SERIAL: /usr/bin/test/gui-wm-client.exe --surface-budget >/tmp/gui-budget.client.log 2>&1 & echo $! >/tmp/gui-budget.client.pid
SERIAL: while test ! -e /tmp/gui-budget.staged && kill -0 $(cat /tmp/gui-budget.client.pid) 2>/dev/null; do sleep 1; done; cat /tmp/gui-budget.client.log
SERIAL-CHECK: wm-client: overlapping staging ready
GUI-CHECK-RECT: 500 500 32 32 34 86 136
SERIAL: touch /tmp/gbpaint
SERIAL-WAIT-FILE: /tmp/gbready
SERIAL: while ! grep -q 'budget pressure' /tmp/gui-budget.terminal.log; do sleep 1; done; kill -0 $(cat /tmp/gui-budget.terminal.pid) && cat /tmp/gui-budget.terminal.log
SERIAL-CHECK: budget pressure
TIMEOUT: 60
SERIAL: old_shell=$(pgrep mario-desktop); kill "$old_shell"; while test -e /tmp/mario-wm.started && test $(grep -c 'private connection ready' /tmp/mario-wm.log) -lt 2; do sleep 1; done; cat /tmp/mario-wm.log; replacement=$(pgrep mario-desktop); test -n "$replacement" && test "$replacement" != "$old_shell" && test $(grep -c 'private connection ready' /tmp/mario-wm.log) -ge 2 && kill -0 $(cat /tmp/gui-budget.terminal.pid) && printf 'surface-budget: shell replaced with staging live\n'
SERIAL-CHECK: surface-budget: shell replaced with staging live
TIMEOUT: 120
GUI-CHECK-RECT: 500 500 32 32 34 86 136
SERIAL: touch /tmp/gui-budget.paint
SERIAL: while test ! -e /tmp/gui-budget.painted && kill -0 $(cat /tmp/gui-budget.client.pid) 2>/dev/null; do sleep 1; done; cat /tmp/gui-budget.client.log; test -e /tmp/gui-budget.painted && printf 'surface-budget: repaint complete\n'
SERIAL-CHECK: surface-budget: repaint complete
GUI-CHECK-RECT: 500 500 32 32 68 136 102
SERIAL: kill -0 $(cat /tmp/gui-budget.terminal.pid); touch /tmp/gui-budget.release
SERIAL: while test ! -e /tmp/gui-budget.done && kill -0 $(cat /tmp/gui-budget.client.pid) 2>/dev/null; do sleep 1; done; cat /tmp/gui-budget.client.log
SERIAL: wait $(cat /tmp/gui-budget.client.pid); cat /tmp/gui-budget.client.log
SERIAL-CHECK: wm-client: surface workload and reclamation pass
GUI-CHECK-RECT: 900 500 32 32 31 41 51
GUI-MOUSE-MOVE: 64,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,99
GUI-MOUSE-BUTTON: left,down
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 128 96 8 8 17 24 39
GUI-TYPE: input
GUI-SEND-KEY: ret
SERIAL-WAIT-FILE: /tmp/gbtyped
SERIAL: kill -TERM $(cat /tmp/gui-budget.terminal.pid); kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started && kill -0 $(cat /tmp/mario-wm.pid) 2>/dev/null; do sleep 1; done; test ! -e /tmp/mario-wm.started && printf 'surface-budget: clean teardown\n'
SERIAL-CHECK: surface-budget: clean teardown
EXIT:
