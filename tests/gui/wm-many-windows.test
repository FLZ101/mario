GUI-TYPE: exit
SERIAL: while kill -0 $(cat /tmp/gui-many.term2.pid) 2>/dev/null; do sleep 1; done; wait $(cat /tmp/gui-many.term2.pid) && printf "many-windows: terminal two clean exit\n"
SERIAL-CHECK: many-windows: terminal two clean exit
SERIAL: touch /tmp/gui-many.finish
SERIAL: while test ! -e /tmp/gui-many.done && kill -0 $(cat /tmp/gui-many.pid) 2>/dev/null; do sleep 1; done; cat /tmp/gui-many.log
SERIAL-CHECK: wm-client: paged workloads and resource reclamation pass
GUI-MOUSE-MOVE: -127,-127
GUI-MOUSE-MOVE: -25,-127
GUI-MOUSE-MOVE: 0,-127
GUI-MOUSE-MOVE: 0,-127
GUI-MOUSE-MOVE: 0,-127
GUI-MOUSE-MOVE: 0,-101
GUI-CHECK-RECT: 128 752 8 8 71 85 105
SERIAL: while test "$(ls /proc/$(cat /tmp/mario-wm.pid)/fd | wc -l)" != "$(cat /tmp/gui-many.wm-fds)"; do sleep 1; done; test "$(ls /proc/$(pgrep mario-desktop)/fd | wc -l)" = "$(cat /tmp/gui-many.shell-fds)" && kill -0 $(cat /tmp/mario-wm.pid) && printf "many-windows: WM and shell descriptor counts restored\n"
SERIAL-CHECK: many-windows: WM and shell descriptor counts restored
SERIAL: /usr/bin/test/pty.exe
SERIAL-CHECK: pty-ok
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; printf "many-windows: clean teardown\n"
SERIAL-CHECK: many-windows: clean teardown
EXIT:
