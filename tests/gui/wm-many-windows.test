GUI-VISUAL-TEST:
TIMEOUT: 30
SERIAL: rm -f /tmp/mario-wm.* /tmp/gui-many.*; /usr/bin/mario-wm --diagnostics >>/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while test -e /tmp/mario-wm.started && ! grep -q 'private connection ready' /tmp/mario-wm.log; do sleep 1; done; cat /tmp/mario-wm.log
SERIAL-CHECK: mario-desktop: private connection ready
SERIAL: many_shell_pid=$(pgrep mario-desktop); ls /proc/$(cat /tmp/mario-wm.pid)/fd | wc -l >/tmp/gui-many.wm-fds; ls /proc/$many_shell_pid/fd | wc -l >/tmp/gui-many.shell-fds
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,down
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,up
GUI-TYPE: shell
SERIAL: test "$(pgrep mario-desktop)" = "$many_shell_pid" && printf 'many-windows: shell survives background keyboard input\n'
SERIAL-CHECK: many-windows: shell survives background keyboard input
SERIAL: <<TERMINAL
cat >/tmp/gui-many.term1.sh <<'SCRIPT'
stty size >/tmp/gui-many.term1.size
while read line; do
    printf '%s\n' "$line" >>/tmp/gui-many.term1.input
    test "$line" = exit && exit 0
done
SCRIPT
TERMINAL
SERIAL: /usr/bin/terminal --command '/bin/oksh /tmp/gui-many.term1.sh' >/tmp/gui-many.term1.log 2>&1 & echo $! >/tmp/gui-many.term1.pid
SERIAL-WAIT-FILE: /tmp/gui-many.term1.size
SERIAL: test "$(cat /tmp/gui-many.term1.size)" = "10 36" && printf "many-windows: terminal 1 size ready\n"
SERIAL-CHECK: many-windows: terminal 1 size ready
SERIAL: <<TERMINAL
cat >/tmp/gui-many.term2.sh <<'SCRIPT'
stty size >/tmp/gui-many.term2.size
while read line; do
    printf '%s\n' "$line" >>/tmp/gui-many.term2.input
    test "$line" = exit && exit 0
done
SCRIPT
TERMINAL
SERIAL: /usr/bin/terminal --command '/bin/oksh /tmp/gui-many.term2.sh' >/tmp/gui-many.term2.log 2>&1 & echo $! >/tmp/gui-many.term2.pid
SERIAL-WAIT-FILE: /tmp/gui-many.term2.size
SERIAL: test "$(cat /tmp/gui-many.term2.size)" = "10 36" && printf "many-windows: terminal 2 size ready\n"
SERIAL-CHECK: many-windows: terminal 2 size ready
SERIAL: /usr/bin/test/gui-wm-client.exe --many-windows >>/tmp/gui-many.log 2>&1 & echo $! >/tmp/gui-many.pid
SERIAL: while test ! -e /tmp/gui-many.initial && kill -0 $(cat /tmp/gui-many.pid) 2>/dev/null; do sleep 1; done; cat /tmp/gui-many.log
SERIAL-CHECK: wm-client: fourteen 320x192 windows ready beside two real terminals
GUI-CHECK-SCREEN-RECT: assets/wm-many-windows.png,0,740,1024,28
