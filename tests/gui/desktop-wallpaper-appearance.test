GUI-VISUAL-TEST:
SERIAL: cat /root/.config/mario/desktop.conf /root/.config/mario/terminal.conf
SERIAL-CHECK: font_family=bitmap
SERIAL-CHECK: font_size=10
SERIAL-CHECK: wallpaper=/usr/share/mario/wallpaper.png
SERIAL-CHECK: font_size=14
SERIAL-CHECK: opacity=100
SERIAL: printf 'wallpaper=/usr/share/mario-tests/gui/checker-64.bmp\nbackground=#102030\n' >/root/.config/mario/desktop.conf
SERIAL: rm -f /tmp/mario-wm.*; /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'private connection ready' /tmp/mario-wm.log; do sleep 1; done; grep 'wallpaper loaded' /tmp/wallpaper.log
SERIAL-CHECK: wallpaper loaded: /usr/share/mario-tests/gui/checker-64.bmp (64x64)
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 239 68 68
GUI-CHECK-RECT: 256 0 8 8 34 197 94
GUI-CHECK-RECT: 0 400 8 8 59 130 246
GUI-CHECK-RECT: 0 752 8 8 17 24 39
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; rm -f /tmp/mario-wm.*
SERIAL: MARIO_WALLPAPER= /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 16 32 48
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; rm -f /tmp/mario-wm.*
SERIAL: mkdir -p /usr/share/mario; cp /usr/share/mario-tests/gui/checker-64.bmp /usr/share/mario/wallpaper.png; printf 'wallpaper=\nbackground=#102030\n' >/root/.config/mario/desktop.conf
SERIAL: /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 16 32 48
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done; rm -f /tmp/mario-wm.*
SERIAL: MARIO_WALLPAPER=/usr/share/mario-tests/gui/checker-64.bmp /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'private connection ready' /tmp/mario-wm.log; do sleep 1; done; grep 'wallpaper loaded' /tmp/wallpaper.log
SERIAL-CHECK: wallpaper loaded: /usr/share/mario-tests/gui/checker-64.bmp (64x64)
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 8 8 239 68 68
GUI-CHECK-RECT: 256 0 8 8 34 197 94
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
