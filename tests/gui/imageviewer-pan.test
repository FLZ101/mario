GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.* /tmp/imageviewer.log /tmp/imageviewer.pid; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/imageviewer /usr/share/mario-tests/gui/large-1600x1200.png >/tmp/imageviewer.log 2>&1 & echo $! >/tmp/imageviewer.pid
SERIAL: while ! grep -q 'imageviewer: window ready' /tmp/imageviewer.log; do sleep 1; done
GUI-SEND-KEY: 1
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 128 96 1 1 102 100 160
GUI-SEND-KEY: left
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 128 96 1 1 142 100 160
GUI-SEND-KEY: left
GUI-WAIT-FRAME:
GUI-SEND-KEY: left
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 128 96 1 1 204 100 160
GUI-SEND-KEY: left
GUI-CHECK-RECT: 128 96 1 1 204 100 160
GUI-SEND-KEY: 1
GUI-WAIT-FRAME:
GUI-MOUSE-MOVE: 200,200
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-MOVE: 64,0
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 128 96 1 1 91 100 160
GUI-MOUSE-BUTTON: left,up
GUI-SEND-KEYS: meta_l,w
SERIAL: while pgrep imageviewer >/dev/null; do sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
