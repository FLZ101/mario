GUI-VISUAL-TEST:
SERIAL: /usr/bin/test/terminal-vt.exe
SERIAL-CHECK: terminal-vt: incremental pixels match full rendering and resize failures preserve state
SERIAL: rm -f /tmp/mario-wm.* /tmp/terminal-damage.paint; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & damage_wm=$!
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
SERIAL: /usr/bin/terminal --command "printf '\033[?25l\033[7m \033[0m'; while test ! -e /tmp/terminal-damage.paint; do sleep 1; done; printf '\033[7m \033[0m'; sleep 70" >/tmp/terminal-damage.log 2>&1 & damage_term=$!
SERIAL: while ! grep -q 'terminal: window ready' /tmp/terminal-damage.log; do sleep 1; done
GUI-CHECK-RECT: 128 100 8 8 248 250 252
GUI-CHECK-RECT: 136 100 8 8 17 24 39
SERIAL: touch /tmp/terminal-damage.paint
GUI-CHECK-RECT: 136 100 8 8 248 250 252
GUI-CHECK-RECT: 128 100 8 8 248 250 252
GUI-SEND-KEYS: meta_l,w
SERIAL: wait "$damage_term" && printf 'terminal damage: clean close\n'
SERIAL-CHECK: terminal damage: clean close
GUI-SEND-KEY: f6
SERIAL: kill -TERM "$damage_wm"; while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
