GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.* /tmp/terminal-render.log /tmp/terminal-render.pid; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/terminal --command "printf '\033[?25l\033[7m \033[0m'; sleep 70" >/tmp/terminal-render.log 2>&1 & echo $! >/tmp/terminal-render.pid
SERIAL: while ! grep -q 'terminal: window ready' /tmp/terminal-render.log; do sleep 1; done
GUI-CHECK-RECT: anywhere 8 16 248 250 252
GUI-SEND-KEYS: meta_l,w
SERIAL: while pgrep terminal >/dev/null; do sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
