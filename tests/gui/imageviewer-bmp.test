GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.* /tmp/imageviewer.log /tmp/imageviewer.pid; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/imageviewer /usr/share/mario-tests/gui/checker-64.bmp >/tmp/imageviewer.log 2>&1 & echo $! >/tmp/imageviewer.pid
# Bound the readiness wait: if imageviewer dies during window setup, fail with
# its log instead of spinning until the harness times out.
SERIAL: while ! grep -q 'imageviewer: window ready' /tmp/imageviewer.log && kill -0 "$(cat /tmp/imageviewer.pid)" 2>/dev/null; do sleep 1; done
SERIAL: cat /tmp/imageviewer.log
SERIAL-CHECK: imageviewer: window ready
# "window ready" is printed before the WM composes the commit, so wait for a
# completed frame before sampling the screen.
GUI-WAIT-FRAME:
GUI-CHECK-SCREEN-RECT: assets/imageviewer-bmp-native.png,216,152,16,16,anywhere
GUI-SEND-KEY: right
GUI-WAIT-FRAME:
GUI-CHECK-SCREEN-RECT: assets/imageviewer-bmp-zoomed.png,132,102,32,24,anywhere
GUI-SEND-KEY: left
GUI-WAIT-FRAME:
GUI-CHECK-SCREEN-RECT: assets/imageviewer-bmp-native.png,216,152,16,16,anywhere
GUI-SEND-KEYS: meta_l,w
SERIAL: while pgrep imageviewer >/dev/null; do sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
