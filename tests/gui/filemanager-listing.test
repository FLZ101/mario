GUI-VISUAL-TEST:
# Fixed names, sizes, and mtimes make the complete column layout reproducible.
SERIAL: <<SETUP
rm -rf /tmp/filemanager-listing /tmp/mario-wm.* /tmp/filemanager-listing.log /tmp/filemanager-listing.pid
mkdir /tmp/filemanager-listing
printf abc >/tmp/filemanager-listing/alpha.txt
printf 12345 >/tmp/filemanager-listing/notes
mkdir /tmp/filemanager-listing/docs
ln -s alpha.txt /tmp/filemanager-listing/link-to-alpha
touch -t 202401020304.05 /tmp/filemanager-listing/alpha.txt /tmp/filemanager-listing/notes /tmp/filemanager-listing/docs
touch -h -t 202401020304.05 /tmp/filemanager-listing/link-to-alpha
# Publish all fixture entries before a second SMP guest process reads them.
sync
/usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SETUP
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/filemanager /tmp/filemanager-listing >/tmp/filemanager-listing.log 2>&1 & echo $! >/tmp/filemanager-listing.pid
SERIAL: while ! grep -q 'filemanager: window ready' /tmp/filemanager-listing.log; do sleep 1; done
SERIAL: cat /tmp/filemanager-listing.log
SERIAL-CHECK: (4 entries)
GUI-CHECK-MATCH: assets/filemanager-listing.ppm
# Down moves the highlighted row without changing the bounded listing model.
GUI-SEND-KEY: down
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 133 121 1 1 17 24 39
GUI-CHECK-RECT: 133 137 1 1 29 78 216
GUI-SEND-KEYS: meta_l,w
SERIAL: while pgrep filemanager >/dev/null; do sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
