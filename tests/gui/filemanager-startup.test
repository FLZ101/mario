GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.* /tmp/filemanager.log /tmp/filemanager.pid; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/filemanager / >/tmp/filemanager.log 2>&1 & echo $! >/tmp/filemanager.pid
SERIAL: while ! grep -q 'filemanager: window ready: /' /tmp/filemanager.log; do sleep 1; done; cat /tmp/filemanager.log
SERIAL-CHECK: filemanager: window ready: /
GUI-CHECK-RECT: 128 96 1 1 17 24 39
SERIAL: kill -TERM $(cat /tmp/filemanager.pid)
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
