GUI-VISUAL-TEST:
TIMEOUT: 120
SERIAL: rm -f /tmp/mario-wm.* /tmp/filemanager-ext2.log /tmp/filemanager-ext2.pid; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
# The test mounts a fixture read-only and lets QEMU teardown release it.
SERIAL: mount -t ext2 -o ro /dev/hdc3 /mnt; echo ext2-mount-status:$?
SERIAL-CHECK: ext2-mount-status:0
SERIAL: /usr/bin/filemanager /mnt >/tmp/filemanager-ext2.log 2>&1 & echo $! >/tmp/filemanager-ext2.pid
SERIAL: while ! grep -q 'filemanager: window ready: /mnt' /tmp/filemanager-ext2.log; do sleep 1; done
GUI-CHECK-RECT: 128 96 1 1 17 24 39
GUI-SEND-KEY: slash
GUI-WAIT-FRAME:
GUI-TYPE: /mnt/data
GUI-WAIT-FRAME:
SERIAL: while ! grep -q 'filemanager: navigated: /mnt/data' /tmp/filemanager-ext2.log; do sleep 1; done; cat /tmp/filemanager-ext2.log
SERIAL-CHECK: filemanager: navigated: /mnt/data
GUI-SEND-KEYS: meta_l,w
SERIAL: while pgrep filemanager >/dev/null; do sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
