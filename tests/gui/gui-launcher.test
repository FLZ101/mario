GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.* /tmp/gui-launcher.log /tmp/gui-launcher.pid; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
# Move from the WM's initial cursor to the MENU panel button at (24,754).
GUI-MOUSE-MOVE: 16,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,127
GUI-MOUSE-MOVE: 0,111
GUI-MOUSE-BUTTON: left,down
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,up
# The one-entry popup occupies y=720..740 above the bottom panel.
GUI-CHECK-RECT: 100 690 1 1 31 41 51
GUI-CHECK-RECT: 100 720 1 1 37 99 235
# Terminal is the only entry at y=720..740.
GUI-MOUSE-MOVE: 0,-32
GUI-MOUSE-BUTTON: left,down
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 100 720 1 1 31 41 51
SERIAL: while ! pgrep terminal >/dev/null; do sleep 1; done; echo launcher: terminal started
SERIAL-CHECK: launcher: terminal started
GUI-CHECK-RECT: 100 690 1 1 31 41 51
SERIAL: while pgrep terminal >/dev/null; do kill -TERM $(pgrep terminal) 2>/dev/null; sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
