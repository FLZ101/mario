GUI-VISUAL-TEST:
TIMEOUT: 10
SERIAL: rm -f /tmp/mario-wm.* /tmp/fltk-demo.*; /usr/bin/mario-wm --diagnostics >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: for attempt in 1 2 3 4 5; do grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log && break; sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
SERIAL: terminal --command 'touch /tmp/fltk-demo.terminal-ready; exec /bin/oksh' >/tmp/fltk-demo.terminal-log 2>&1 & echo $! >/tmp/fltk-demo.terminal-pid
SERIAL-WAIT-FILE: /tmp/fltk-demo.terminal-ready
SERIAL: /usr/bin/test/fltk-demo.exe >/tmp/fltk-demo.log 2>&1 & echo $! >/tmp/fltk-demo.pid
GUI-CHECK-SCREEN-RECT: assets/fltk-demo-ready.png,738,93,28,28,anywhere
GUI-CLICK: assets/fltk-demo-ready.png,527,99,38,16
GUI-CHECK-SCREEN-RECT: assets/fltk-demo-clicked.png,738,93,28,28,anywhere
# The entry field is directly below the Click button.
GUI-CLICK: assets/fltk-demo-ready.png,527,99,38,16,19,49
GUI-SEND-KEY: a
GUI-SEND-KEY: x
GUI-SEND-KEY: left
GUI-SEND-KEY: delete
GUI-SEND-KEY: b
GUI-SEND-KEYS: shift,c
GUI-CHECK-SCREEN-RECT: assets/fltk-demo-edited.png,738,93,28,28,anywhere
GUI-POINT: assets/fltk-demo-ready.png,527,99,38,16
GUI-MOUSE-BUTTON: left,down
GUI-CHECK-SCREEN-RECT: assets/fltk-demo-pressed.png,738,93,28,28,anywhere
GUI-SEND-KEYS: alt,tab
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-SCREEN-RECT: assets/fltk-demo-cancelled.png,738,93,28,28,anywhere
GUI-POINT: assets/fltk-demo-ready.png,495,189,140,16,45,24
GUI-MOUSE-WHEEL: down
GUI-CHECK-SCREEN-RECT: assets/fltk-demo-scrolled.png,738,93,28,28,anywhere
GUI-SEND-KEYS: alt,tab
GUI-SEND-KEYS: meta_l,w
GUI-CHECK-SCREEN-RECT: assets/fltk-demo-close-requested.png,738,93,28,28,anywhere
GUI-SEND-KEYS: meta_l,w
SERIAL: wait $(cat /tmp/fltk-demo.pid); cat /tmp/fltk-demo.log
SERIAL-CHECK: fltk-demo: input, reset, timers, fd callbacks and close verified
SERIAL: kill $(cat /tmp/fltk-demo.terminal-pid); kill -TERM $(cat /tmp/mario-wm.pid)
EXIT:
