GUI-VISUAL-TEST:
SERIAL: <<SETUP
rm -rf /tmp/fm /tmp/mario-wm.* /tmp/fm.log /tmp/fm.pid
mkdir /tmp/fm
mkdir /tmp/fm/old /tmp/fm/taken
sync
/usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SETUP
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! /bin/toybox/grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do /bin/toybox/sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/filemanager /tmp/fm >/tmp/fm.log 2>&1 & echo $! >/tmp/fm.pid
SERIAL: while ! /bin/toybox/grep -q 'filemanager: window ready' /tmp/fm.log; do /bin/toybox/sleep 1; done
SERIAL: /bin/toybox/sleep 1
GUI-CHECK-RECT: 128 96 1 1 17 24 39
# The alphabetical first entry is old.  Its duplicate rename must fail intact.
GUI-SEND-KEY: r
GUI-WAIT-FRAME:
GUI-TYPE: taken
GUI-WAIT-FRAME:
SERIAL: while ! /bin/toybox/grep -q 'filemanager: rename failed: /tmp/fm/taken: 17' /tmp/fm.log; do /bin/toybox/sleep 1; done
SERIAL: test -d /tmp/fm/old -a -d /tmp/fm/taken; echo rename-duplicate-status:$?
SERIAL-CHECK: rename-duplicate-status:0
GUI-SEND-KEY: esc
GUI-WAIT-FRAME:
# A second rename refreshes the listing and keeps the old destination unchanged.
GUI-SEND-KEY: r
GUI-WAIT-FRAME:
GUI-TYPE: renamed
GUI-WAIT-FRAME:
SERIAL: while ! /bin/toybox/grep -q 'filemanager: renamed: /tmp/fm/old -> /tmp/fm/renamed' /tmp/fm.log; do /bin/toybox/sleep 1; done
SERIAL: test ! -e /tmp/fm/old -a -d /tmp/fm/renamed -a -d /tmp/fm/taken; echo rename-status:$?
SERIAL-CHECK: rename-status:0
# Names are entries, not paths: slash input is rejected before filesystem mutation.
GUI-SEND-KEY: m
GUI-WAIT-FRAME:
GUI-TYPE: bad/name
GUI-WAIT-FRAME:
SERIAL: while ! /bin/toybox/grep -q 'filemanager: name failed: bad/name: 22' /tmp/fm.log; do /bin/toybox/sleep 1; done
SERIAL: test ! -e /tmp/fm/bad; echo mkdir-name-status:$?
SERIAL-CHECK: mkdir-name-status:0
GUI-SEND-KEY: esc
GUI-WAIT-FRAME:
# Create a directory, then verify that its duplicate request reports EEXIST.
GUI-SEND-KEY: m
GUI-WAIT-FRAME:
GUI-TYPE: made
GUI-WAIT-FRAME:
SERIAL: while ! /bin/toybox/grep -q 'filemanager: created directory: /tmp/fm/made' /tmp/fm.log; do /bin/toybox/sleep 1; done
SERIAL: test -d /tmp/fm/made; echo mkdir-status:$?
SERIAL-CHECK: mkdir-status:0
GUI-SEND-KEY: m
GUI-WAIT-FRAME:
GUI-TYPE: made
GUI-WAIT-FRAME:
SERIAL: while ! /bin/toybox/grep -q 'filemanager: mkdir failed: /tmp/fm/made: 17' /tmp/fm.log; do /bin/toybox/sleep 1; done
GUI-SEND-KEY: esc
GUI-WAIT-FRAME:
# Lexically prefixed paths can escape /tmp; the resolved guard rejects them.
GUI-SEND-KEY: slash
GUI-WAIT-FRAME:
GUI-TYPE: /tmp/..
GUI-WAIT-FRAME:
SERIAL: cat /tmp/fm.log
SERIAL-CHECK: filemanager: navigated: /tmp/..
GUI-SEND-KEY: m
GUI-WAIT-FRAME:
SERIAL: cat /tmp/fm.log
SERIAL-CHECK: filemanager: mutation rejected outside /tmp: /tmp/..
GUI-SEND-KEYS: meta_l,w
SERIAL: while /bin/toybox/pgrep filemanager >/dev/null; do /bin/toybox/sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do /bin/toybox/sleep 1; done
EXIT:
