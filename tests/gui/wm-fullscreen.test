GUI-VISUAL-TEST:
TIMEOUT: 90
SERIAL: <<TEXTVT
{
    printf '\033[2J\033[H\033[8;20HVT6-MARKER'
    for row in 1 2 3; do
        printf "\033[${row};1H\033[46m                    \033[${row};60H\033[42m                    "
    done
    for row in 23 24 25; do
        printf "\033[${row};1H\033[45m                    \033[${row};60H\033[43m                    "
    done
    printf '\033[0m\033[8;20HVT6-MARKER'
} >/dev/tty6
TEXTVT
SERIAL: rm -f /tmp/mario-wm.* /tmp/gui-fullscreen.*; /usr/bin/mario-wm --diagnostics >>/tmp/mario-wm.log 2>&1 & wm_pid=$!
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done; shell_pid=$(pgrep mario-desktop)
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
SERIAL: ( /usr/bin/test/gui-wm-client.exe --fullscreen; fixture_status=$?; printf '%s\n' "$fixture_status" >/tmp/gui-fullscreen.status-new; mv /tmp/gui-fullscreen.status-new /tmp/gui-fullscreen.status; while test ! -e /tmp/gui-fullscreen.release; do sleep 1; done; exit "$fixture_status" ) >/tmp/gui-fullscreen.log 2>&1 & client_pid=$!
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.ready
GUI-CHECK-RECT: 144 112 32 32 34 86 136
GUI-CHECK-RECT: 680 80 128 96 221 136 68
GUI-MOUSE-MOVE: 127,127
