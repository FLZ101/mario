GUI-CHECK-RECT: 144 112 320 192 34 86 136
GUI-CHECK-RECT: 680 80 128 96 221 136 68
GUI-CHECK-SCREEN-RECT: assets/wm-fullscreen-restored.png,0,0,900,740
GUI-SEND-KEYS: meta_l,f
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.pending-4
GUI-CHECK-RECT: 144 112 320 192 34 86 136
SERIAL: touch /tmp/gui-fullscreen.commit-4
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.frame-4
GUI-CHECK-RECT: 0 0 1000 768 68 136 102
SERIAL: rm -f /tmp/gui-fullscreen.focus-sibling
GUI-SEND-KEYS: alt,tab
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.pending-5
SERIAL: test ! -e /tmp/gui-fullscreen.focus-sibling && printf 'fullscreen: activation waits for restore pixels\n'
