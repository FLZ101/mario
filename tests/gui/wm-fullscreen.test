GUI-SEND-KEYS: meta_l,f
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.pending-6
GUI-SEND-KEY: f1
SERIAL: while test -e /tmp/mario-wm.ready; do sleep 1; done; touch /tmp/gui-fullscreen.commit-6
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.frame-6
SERIAL: test ! -e /tmp/mario-wm.ready && test $(pgrep mario-wm) = "$wm_pid" && test $(pgrep mario-desktop) = "$shell_pid" && printf 'fullscreen: suspended mode and session survive\n'
SERIAL-CHECK: fullscreen: suspended mode and session survive
GUI-SEND-KEY: f6
GUI-CHECK-SCREEN: assets/fb-tty.ppm
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-RECT: 0 0 1024 128 68 136 102
GUI-CHECK-SCREEN: assets/wm-fullscreen.png
SERIAL: kill "$shell_pid"; while test $(grep -c 'private connection ready' /tmp/mario-wm.log) -lt 2; do sleep 1; done; replacement=$(pgrep mario-desktop); test "$replacement" != "$shell_pid" && test $(pgrep mario-wm) = "$wm_pid" && printf 'fullscreen: replacement shell retains owner\n'
SERIAL-CHECK: fullscreen: replacement shell retains owner
GUI-CHECK-RECT: 0 0 1024 128 68 136 102
GUI-CHECK-SCREEN: assets/wm-fullscreen.png
GUI-SEND-KEYS: meta_l,w
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.sibling-live
GUI-CHECK-RECT: 680 80 128 96 221 136 68
GUI-MOUSE-MOVE: 127,0
GUI-WAIT-FRAME:
GUI-MOUSE-MOVE: 127,0
