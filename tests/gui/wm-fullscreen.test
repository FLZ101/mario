GUI-WAIT-FRAME:
GUI-MOUSE-MOVE: 12,0
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
GUI-SEND-KEYS: meta_l,w
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.done
SERIAL-WAIT-FILE: /tmp/gui-fullscreen.status
SERIAL: fixture_status=$(cat /tmp/gui-fullscreen.status); touch /tmp/gui-fullscreen.release; wait "$client_pid"; wrapper_status=$?; cat /tmp/gui-fullscreen.log; test "$fixture_status" -eq 0 && test "$wrapper_status" -eq 0 && printf 'fullscreen: fixture exited cleanly\n'
SERIAL-CHECK: wm-client: fullscreen, exact restore, edges and cooperative sibling close pass
SERIAL-CHECK: fullscreen: fixture exited cleanly
SERIAL: kill -TERM "$wm_pid"; wait "$wm_pid"; test ! -e /tmp/mario-wm.started && printf 'fullscreen: clean teardown\n'
SERIAL-CHECK: fullscreen: clean teardown
GUI-SEND-KEY: f6
GUI-CHECK-SCREEN: assets/fb-tty.ppm
EXIT:
