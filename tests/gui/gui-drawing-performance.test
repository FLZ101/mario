GUI-VISUAL-TEST:
SERIAL: /usr/bin/test/gui-wm-busy.exe >/tmp/gui-perf.work 2>&1; cat /tmp/gui-perf.work
SERIAL-CHECK: gui-wm-busy: drawing work is counted independently of logical flushes
SERIAL-CHECK: gui-wm-busy: sixteen windows preserve bounded drawing, motion and reclaimed capacity
SERIAL-CHECK: gui-wm-busy: live uploads service PTY, keys and resize with bounded single-cell traffic
SERIAL: printf 'padding=16\n' >>/root/.config/mario/terminal.conf
SERIAL: rm -f /tmp/mario-wm.* /tmp/gui-perf.finish; /usr/bin/mario-wm --diagnostics >/tmp/mario-wm.log 2>&1 & perf_wm=$!
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
SERIAL: perf_shell=$(pgrep mario-desktop); perf_wm_fds=$(ls /proc/$perf_wm/fd | wc -l); perf_shell_fds=$(ls /proc/$perf_shell/fd | wc -l); perf_ptys=$(/usr/bin/test/gui-cleanup.exe --pty-pool)
SERIAL: <<FIXTURE
cat >/tmp/gui-perf.run <<'PAINT'
printf '\033[?25l\033[48;2;19;83;137m\033[2J'
set -- $(stty size)
columns=$(($2 - 1))
for row in $(seq 1 "$1"); do
    printf '\033[%s;1H%*s' "$row" "$columns" ''
done
printf '\033[H'
while test ! -e /tmp/gui-perf.finish; do sleep 1; done
PAINT
FIXTURE
SERIAL: /usr/bin/terminal --command ". /tmp/gui-perf.run" >/tmp/gui-perf.term 2>&1 & perf_terminal=$!
SERIAL: while ! grep -q 'terminal: window ready' /tmp/gui-perf.term; do sleep 1; done
GUI-CHECK-RECT: 144 112 8 8 19 83 137
GUI-MOUSE-MOVE: 144,68
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-MOVE: 32,0
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 448 128 8 8 19 83 137
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-MOVE: -32,0
GUI-WAIT-FRAME:
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 144 112 8 8 19 83 137
SERIAL: touch /tmp/gui-perf.finish
SERIAL: wait "$perf_terminal" && printf 'gui-performance: terminal closed\n'
SERIAL-CHECK: gui-performance: terminal closed
GUI-CHECK-RECT: 144 112 8 8 29 78 216
SERIAL: <<MANY
cat >/tmp/gui-perf-many.run <<'CHILD'
index=$1
stty size >/tmp/gui-perf-many.size.$index
printf '\033[?25l\033[48;2;%s;83;137m\033[2J' "$index"
set -- $(stty size)
columns=$(($2 - 1))
for row in $(seq 1 "$1"); do
    printf '\033[%s;1H%*s' "$row" "$columns" ''
done
printf '\033[H'
while read line; do
    printf '%s\n' "$line" >>/tmp/gui-perf-many.input.$index
    test "$line" = size && stty size >/tmp/gui-perf-many.size.$index
    test "$line" = exit && exit 0
done
CHILD
MANY
SERIAL: perf_close_ok=1; for index in $(seq 1 16); do ( /usr/bin/terminal --command ". /tmp/gui-perf-many.run $index" >/tmp/gui-perf-many.log.$index 2>&1; result=$?; echo "$result" >/tmp/gui-perf-many.status.$index; while test ! -e /tmp/gui-perf-many.release.$index; do sleep 1; done; exit "$result" ) & perf_last=$!; echo "$perf_last" >/tmp/gui-perf-many.pid.$index; while test ! -e /tmp/gui-perf-many.size.$index; do sleep 1; done; done; test "$(pgrep terminal | wc -l)" -eq 16 && printf 'gui-performance: sixteen terminals ready\n'
SERIAL-CHECK: gui-performance: sixteen terminals ready
GUI-CHECK-RECT: 656 496 8 8 16 83 137
GUI-TYPE: a
SERIAL: while test ! -e /tmp/gui-perf-many.input.16; do sleep 1; done; grep -qx a /tmp/gui-perf-many.input.16 && printf 'gui-performance: final input preserved\n'
SERIAL-CHECK: gui-performance: final input preserved
GUI-SEND-KEYS: meta_l,f
GUI-WAIT-FRAME:
GUI-TYPE: size
SERIAL: while ! grep -qx '46 124' /tmp/gui-perf-many.size.16; do sleep 1; done
GUI-CHECK-RECT: 16 144 8 8 16 83 137
GUI-SEND-KEYS: meta_l,f
GUI-WAIT-FRAME:
GUI-TYPE: size
SERIAL: while ! grep -qx '10 36' /tmp/gui-perf-many.size.16; do sleep 1; done
GUI-CHECK-RECT: 656 496 8 8 16 83 137
SERIAL: healthy_ok=1; for index in $(seq 1 15); do test ! -e /tmp/gui-perf-many.input.$index || { healthy_ok=0; break; }; done; test "$healthy_ok" -eq 1 && printf 'gui-performance: healthy peers unchanged\n'
SERIAL-CHECK: gui-performance: healthy peers unchanged
GUI-TYPE: exit
SERIAL: while test ! -e /tmp/gui-perf-many.status.16; do sleep 1; done; touch /tmp/gui-perf-many.release.16; wait "$perf_last" && test "$(cat /tmp/gui-perf-many.status.16)" -eq 0 && grep -q 'terminal: child exit 0' /tmp/gui-perf-many.log.16 && printf 'gui-performance: top terminal exited cleanly\n'
SERIAL-CHECK: gui-performance: top terminal exited cleanly
GUI-CHECK-RECT: 656 496 8 8 15 83 137
GUI-SEND-KEYS: meta_l,w
GUI-WAIT-FRAME:
