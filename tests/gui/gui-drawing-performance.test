SERIAL: while test "$(ls /proc/$perf_wm/fd | wc -l)" -ne "$perf_wm_fds"; do sleep 1; done; perf_pool_now=$(/usr/bin/test/gui-cleanup.exe --pty-pool); printf 'reclamation: exits=%s ptys=%s/%s shell-fds=%s/%s\n' "$perf_close_ok" "$perf_pool_now" "$perf_ptys" "$(ls /proc/$perf_shell/fd | wc -l)" "$perf_shell_fds"; test "$perf_close_ok" -eq 1 && test "$(ls /proc/$perf_shell/fd | wc -l)" -eq "$perf_shell_fds" && test "$perf_pool_now" -eq "$perf_ptys" && printf 'gui-performance: sixteen terminals reclaimed\n'
SERIAL-CHECK: gui-performance: sixteen terminals reclaimed
SERIAL: cycles_ok=1; for cycle in $(seq 1 16); do /usr/bin/terminal --command "printf 'cycle-%s' $cycle" >/tmp/gui-perf-cycle.log 2>&1 & cycle_pid=$!; wait "$cycle_pid" && grep -q 'terminal: child exit 0' /tmp/gui-perf-cycle.log || { cycles_ok=0; printf 'failed cycle: %s\n' "$cycle"; cat /tmp/gui-perf-cycle.log; break; }; done; test "$cycles_ok" -eq 1 && printf 'gui-performance: sixteen close/reopen cycles passed\n'
SERIAL-CHECK: gui-performance: sixteen close/reopen cycles passed
SERIAL: while test "$(ls /proc/$perf_wm/fd | wc -l)" -ne "$perf_wm_fds"; do sleep 1; done; test "$(pgrep mario-wm)" = "$perf_wm" && test "$(pgrep mario-desktop)" = "$perf_shell" && test -z "$(pgrep terminal)" && test "$(/usr/bin/test/gui-cleanup.exe --pty-pool)" -eq "$perf_ptys" && printf 'gui-performance: final capacity and session preserved\n'
SERIAL-CHECK: gui-performance: final capacity and session preserved
