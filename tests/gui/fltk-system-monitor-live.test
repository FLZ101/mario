GUI-VISUAL-TEST:
TIMEOUT: 12
SERIAL: /usr/bin/mario-wm --diagnostics >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: for attempt in 1 2 3 4 5; do grep -q 'private connection ready' /tmp/mario-wm.log && break; sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
SERIAL: (/usr/bin/test/fltk-system-monitor.exe; echo $? >/tmp/monitor-exit) >/tmp/monitor.log 2>&1 &
SERIAL: <<MONITOR
cat >/tmp/monitor-helpers <<'HELPERS'
await_sample() {
    for attempt in 1 2 3 4 5 6; do
        tail -1 /tmp/monitor.log | grep -Eq "$1" && { printf 'monitor live: %s\n' "$2"; return; }
        sleep 1
    done
    cat /tmp/monitor.log
}
HELPERS
MONITOR
SERIAL: . /tmp/monitor-helpers; cores=$(grep -c '^processor' /proc/cpuinfo); await_sample "cores=$cores " 'all online cores sampled'
SERIAL-CHECK: monitor live: all online cores sampled
SERIAL: /usr/bin/test/fltk-system-monitor.exe busy & workload=$!; await_sample "work=$workload " 'workload appeared'
SERIAL-CHECK: monitor live: workload appeared
SERIAL: await_sample "work=$workload ticks=[1-9][0-9]* rated=1 " 'workload accumulated CPU time'
SERIAL-CHECK: monitor live: workload accumulated CPU time
SERIAL: kill -TERM "$workload"; wait "$workload"; await_sample ' work=0 ' 'workload exited'
SERIAL-CHECK: monitor live: workload exited
# While paused, mount a filesystem. Only the manual refresh should see it.
GUI-MOUSE-POSITION: 755,98
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
SERIAL: sleep 1; paused_count=$(wc -l </tmp/monitor.log); mkdir -p /mnt/monitor && mount -t ext2 /dev/hdc3 /mnt/monitor; sleep 2; test "$(wc -l </tmp/monitor.log)" -eq "$paused_count" && printf 'monitor live: %s\n' 'pause stopped sampling'
SERIAL-CHECK: monitor live: pause stopped sampling
GUI-MOUSE-POSITION: 870,98
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
SERIAL: await_sample ' mounted=1 ' 'mount capacity refreshed'; test "$(wc -l </tmp/monitor.log)" -eq "$((paused_count + 1))" && printf 'monitor live: %s\n' 'manual refresh sampled once'
SERIAL-CHECK: monitor live: mount capacity refreshed
SERIAL-CHECK: monitor live: manual refresh sampled once
GUI-MOUSE-POSITION: 323,137
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
GUI-CHECK-RECT: 300 190 8 8 246 248 251
# Resume with the test sampler held inside collection. Busy ticks must not spawn another worker.
SERIAL: touch /tmp/monitor-hold
GUI-MOUSE-POSITION: 755,98
GUI-MOUSE-BUTTON: left,down
GUI-MOUSE-BUTTON: left,up
SERIAL-WAIT-FILE: /tmp/monitor-worker
SERIAL: helper=$(cat /tmp/monitor-worker); sleep 3; test "$(pgrep -x monitor-sampler)" = "$helper" && test "$(wc -l </tmp/monitor.log)" -eq "$((paused_count + 1))" && printf 'monitor live: %s\n' 'one in-flight worker'
SERIAL-CHECK: monitor live: one in-flight worker
GUI-SEND-KEYS: meta_l,w
SERIAL-WAIT-FILE: /tmp/monitor-exit
SERIAL: test "$(cat /tmp/monitor-exit)" = 0 && test ! -e /proc/$helper && ! pgrep -x monitor-sampler && printf 'monitor live: %s\n' 'closed and reaped worker'; umount /mnt/monitor
SERIAL-CHECK: monitor live: closed and reaped worker
# Open the uninstrumented executable as well.
SERIAL: (/usr/bin/system-monitor; echo $? >/tmp/monitor-default-exit) >/tmp/monitor-default.log 2>&1 &
GUI-CHECK-RECT: 320 206 8 8 232 237 244
GUI-SEND-KEYS: meta_l,w
SERIAL-WAIT-FILE: /tmp/monitor-default-exit
SERIAL: printf 'monitor live: standalone exit=%s\n' "$(cat /tmp/monitor-default-exit)"; kill -TERM $(cat /tmp/mario-wm.pid)
SERIAL-CHECK: monitor live: standalone exit=0
EXIT:
