GUI-VISUAL-TEST:
# A fresh server owns both seat descriptors before F8 exposes graphics.
SERIAL: <<TTY6
{
    printf '\033[2J\033[H\033[8;20HVT6-MARKER'
    for row in 1 2 3; do
        printf "\033[${row};1H\033[46m                    \033[${row};60H\033[42m                    "
    done
    for row in 23 24 25; do
        printf "\033[${row};1H\033[45m                    \033[${row};60H\033[43m                    "
    done
    printf '\033[0m\033[8;20HVT6-MARKER'
} > /dev/tty6
TTY6
GUI-SEND-KEY: f6
GUI-CHECK-SCREEN: assets/fb-tty.ppm
SERIAL: rm -f /tmp/mario-wm.*; /usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: cat /tmp/mario-wm.log
SERIAL-CHECK: mario-wm: listening
SERIAL-CHECK: mario-wm: listening
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done
GUI-SEND-KEY: f8
GUI-CHECK-RECT: 32 32 32 32 31 41 51
# A second startup fails without stealing the first server's seat.
SERIAL: /usr/bin/mario-wm >/tmp/mario-wm-second.log 2>&1; echo wm-second-status:$?
SERIAL-CHECK: wm-second-status:1
SERIAL: test -e /tmp/mario-wm.started; echo wm-owner-status:$?
SERIAL-CHECK: wm-owner-status:0
GUI-CHECK-RECT: 32 32 32 32 31 41 51
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
# The server owns its private shell and must not leave it running after exit.
SERIAL: while pgrep mario-desktop >/dev/null; do sleep 1; done; echo wm-shell-cleanup: ok
SERIAL-CHECK: wm-shell-cleanup: ok
# Closing the last seat descriptors restores the previous text VT without a
# synthetic function-key transition.
GUI-CHECK-SCREEN: assets/fb-tty.ppm
SERIAL: test ! -e /tmp/mario-wm.ready && test ! -e /tmp/mario-wm.frame && echo wm-cleanup: ok
SERIAL-CHECK: wm-cleanup: ok
# A clean loop exit releases the listener and seat so a new server can start.
SERIAL: /usr/bin/mario-wm >/tmp/mario-wm-restart.log 2>&1 & echo $! >/tmp/mario-wm-restart.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: kill -TERM $(cat /tmp/mario-wm-restart.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
