GUI-VISUAL-TEST:
TIMEOUT: 12
SERIAL: /usr/bin/mario-wm --diagnostics >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: for attempt in 1 2 3 4 5; do grep -q 'private connection ready' /tmp/mario-wm.log && break; sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
# Keep the tree stable until the fixture sends the next phase.
SERIAL: /usr/bin/sbase/mkfifo /tmp/monitor-phase
SERIAL: (/usr/bin/test/fltk-system-monitor.exe tree; echo $? >/tmp/monitor-exit) >/tmp/monitor.log 2>&1 &
SERIAL: echo 0 >/tmp/monitor-phase; for attempt in 1 2 3 4 5; do grep -q 'phase=0$' /tmp/monitor.log && { printf 'monitor tree phase=%s ready\n' 0; break; }; sleep 1; done
SERIAL-CHECK: monitor tree phase=0 ready
# Open Processes and enable Tree. Check only the PID and name columns.
GUI-CLICK: assets/fltk-system-monitor-signals.png,190,129,77,16
GUI-CLICK: assets/fltk-system-monitor-signals.png,437,162,57,18
GUI-CHECK-SCREEN-RECT: assets/fltk-system-monitor-tree.png,114,156,188,187,anywhere
# Collapse the session, then filter for its grandchild. Both ancestors remain visible.
GUI-CLICK: assets/fltk-system-monitor-tree.png,195,185,70,17,7,7
GUI-CHECK-SCREEN-RECT: assets/fltk-system-monitor-tree-collapsed.png,114,156,188,124,anywhere
GUI-CLICK: assets/fltk-system-monitor-signals.png,117,163,47,17,88,8
GUI-SEND-KEY: w
GUI-CLICK: assets/fltk-system-monitor-tree.png,234,231,53,16
GUI-CHECK-SCREEN-RECT: assets/fltk-system-monitor-tree-filtered.png,114,156,188,102,anywhere
# Clear the filter, reopen the session, and select its grandchild.
GUI-CLICK: assets/fltk-system-monitor-signals.png,117,163,47,17,88,8
GUI-SEND-KEY: backspace
GUI-CHECK-SCREEN-RECT: assets/fltk-system-monitor-tree-filter-cleared.png,114,156,188,124,anywhere
GUI-CLICK: assets/fltk-system-monitor-tree-filter-cleared.png,195,185,70,17,7,7
GUI-CLICK: assets/fltk-system-monitor-tree.png,234,231,53,16
# Sorting by name moves the whole session branch, not its individual children.
GUI-CLICK: assets/fltk-system-monitor-signals.png,192,199,49,17
GUI-CHECK-SCREEN-RECT: assets/fltk-system-monitor-tree-sorted.png,114,156,188,187,anywhere
# A reused parent PID must not keep its older children or its selection.
GUI-CLICK: assets/fltk-system-monitor-tree-sorted.png,195,254,70,17,7,8
SERIAL: echo 1 >/tmp/monitor-phase; for attempt in 1 2 3 4 5; do grep -q 'phase=1$' /tmp/monitor.log && { printf 'monitor tree phase=%s ready\n' 1; break; }; sleep 1; done
SERIAL-CHECK: monitor tree phase=1 ready
GUI-CHECK-SCREEN-RECT: assets/fltk-system-monitor-tree-reparented.png,114,156,188,187,anywhere
# The editor is now a root. Folding it hides only its own child.
GUI-CLICK: assets/fltk-system-monitor-tree.png,209,208,70,17,7,8
GUI-CHECK-SCREEN-RECT: assets/fltk-system-monitor-tree-editor-collapsed.png,114,156,188,178,anywhere
GUI-SEND-KEYS: meta_l,w
SERIAL-WAIT-FILE: /tmp/monitor-exit
SERIAL: printf 'monitor tree exit=%s\n' "$(cat /tmp/monitor-exit)"; kill -TERM $(cat /tmp/mario-wm.pid)
SERIAL-CHECK: monitor tree exit=0
EXIT:
