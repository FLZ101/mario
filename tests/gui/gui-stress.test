# Orderly shutdown restores the saved text frame without another VT key.
SERIAL: kill -TERM "$wm_pid"; wait "$wm_pid"; while kill -0 "$shell_pid" 2>/dev/null; do sleep 1; done
SERIAL: test ! -e /tmp/mario-wm.sock && test ! -e /tmp/mario-wm.started && test ! -e /tmp/mario-wm.ready && test ! -e /tmp/mario-wm.frame && test "$(/usr/bin/test/gui-cleanup.exe --pty-pool)" -eq "$pty_capacity" && printf 'gui-stress: %s reclaimed\n' session
SERIAL-CHECK: gui-stress: session reclaimed
GUI-CHECK-SCREEN: assets/fb-tty.ppm
GUI-SEND-KEY: f8
GUI-CHECK-SCREEN: assets/fb-tty.ppm
EXIT:
