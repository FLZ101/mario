GUI-CHECK-SCREEN: assets/desktop-idle.png
SERIAL: shell_pid=$(pgrep mario-desktop); wm_descriptors=$(ls /proc/$wm_pid/fd | wc -l); shell_descriptors=$(ls /proc/$shell_pid/fd | wc -l); pty_capacity=$(/usr/bin/test/gui-cleanup.exe --pty-pool)
SERIAL: <<HELPERS
cat >/tmp/gui-stress-helpers <<'FUNCTIONS'
stress_reclaimed() {
    attempt=0
    while test "$(ls /proc/$wm_pid/fd | wc -l)" -ne "$wm_descriptors" ||
          test "$(ls /proc/$shell_pid/fd | wc -l)" -ne "$shell_descriptors" ||
          test "$(pgrep mario-wm)" != "$wm_pid" ||
          test "$(pgrep mario-desktop)" != "$shell_pid" ||
          test -n "$(pgrep terminal)" ||
          ! test "$(/usr/bin/test/gui-cleanup.exe --pty-pool)" -eq "$pty_capacity"; do
        attempt=$((attempt + 1))
        if test "$attempt" -ge 10; then
            echo "gui-stress: resource baseline not restored"
            printf 'gui-stress: wm %s (expected %s), desktop %s (expected %s)\n' "$(pgrep mario-wm)" "$wm_pid" "$(pgrep mario-desktop)" "$shell_pid"
            printf 'gui-stress: terminal processes: %s\n' "$(pgrep terminal)"
            printf 'gui-stress: available PTYs %s (expected %s)\n' "$(/usr/bin/test/gui-cleanup.exe --pty-pool)" "$pty_capacity"
            ls /proc/$wm_pid/fd /proc/$shell_pid/fd
            return 1
        fi
        sleep 1
    done
    return 0
}
FUNCTIONS
HELPERS
SERIAL: . /tmp/gui-stress-helpers; stress_reclaimed && printf 'gui-stress: %s ready\n' baseline
SERIAL-CHECK: gui-stress: baseline ready

# Cycle 1: move, resize, suspend/resume, close, and restore the whole desktop.
SERIAL: rm -f /tmp/gui-stress-winsize; /usr/bin/terminal --command 'exec /usr/bin/test/terminal-winsize.exe /tmp/gui-stress-winsize' >/tmp/gui-stress-terminal.log 2>&1 & terminal_pid=$!
SERIAL: while ! grep -q 'terminal-winsize: ready' /tmp/gui-stress-winsize 2>/dev/null; do sleep 1; done
