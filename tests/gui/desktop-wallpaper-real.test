GUI-VISUAL-TEST:
SERIAL: rm -f /tmp/mario-wm.*; ln -s /usr/share/mario-tests/gui/wallpaper-blue-marble-1920x1200.png /tmp/wallpaper-real.png; MARIO_WALLPAPER=/tmp/wallpaper-real.png /usr/bin/mario-wm >/tmp/mario-wm.log 2>/tmp/wallpaper-real.log & echo $! >/tmp/mario-wm.pid
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do sleep 1; done; grep 'wallpaper loaded' /tmp/wallpaper-real.log
SERIAL-CHECK: wallpaper loaded: /tmp/wallpaper-real.png (1920x1200)
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-SCREEN-RECT: assets/desktop-wallpaper-blue-marble.png,64,672,64,48
SERIAL: rm /tmp/wallpaper-real.png
GUI-CLICK: assets/desktop-default.png,10,747,35,14
GUI-CHECK-SCREEN-RECT: assets/desktop-launcher.png,15,642,84,16,anywhere
GUI-SEND-KEY: esc
GUI-CHECK-SCREEN-RECT: assets/desktop-wallpaper-blue-marble.png,64,672,64,48
SERIAL: /usr/bin/terminal >/tmp/wallpaper-real-terminal.log 2>&1 &
SERIAL: while ! grep -q 'terminal: window ready' /tmp/wallpaper-real-terminal.log; do sleep 1; done
GUI-CHECK-RECT: 130 130 8 8 17 24 39
GUI-SEND-KEYS: meta_l,w
SERIAL: while pgrep terminal >/dev/null; do sleep 1; done
GUI-CHECK-SCREEN-RECT: assets/desktop-wallpaper-blue-marble.png,128,112,64,48
GUI-SEND-KEY: f1
SERIAL: while test -e /tmp/mario-wm.ready; do sleep 1; done
GUI-SEND-KEY: f8
GUI-WAIT-FRAME:
GUI-CHECK-SCREEN-RECT: assets/desktop-wallpaper-blue-marble.png,128,112,64,48
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do sleep 1; done
EXIT:
