GUI-VISUAL-TEST:
SERIAL: <<SETUP
rm -rf /tmp/fm-image-open /tmp/mario-wm.* /tmp/fm-image-open.log /tmp/fm-image-open.pid
mkdir /tmp/fm-image-open
cp /usr/share/mario-tests/gui/alpha-128.png /tmp/fm-image-open/z.png
/usr/bin/mario-wm >/tmp/mario-wm.log 2>&1 & echo $! >/tmp/mario-wm.pid
SETUP
SERIAL-WAIT-FILE: /tmp/mario-wm.started
SERIAL: while ! /bin/toybox/grep -q 'mario-desktop: private connection ready' /tmp/mario-wm.log; do /bin/toybox/sleep 1; done
GUI-SEND-KEY: f8
SERIAL: /usr/bin/filemanager /tmp/fm-image-open >/tmp/fm-image-open.log 2>&1 & echo $! >/tmp/fm-image-open.pid
SERIAL: while ! /bin/toybox/grep -q 'filemanager: window ready' /tmp/fm-image-open.log; do /bin/toybox/sleep 1; done
GUI-CHECK-RECT: 128 96 1 1 17 24 39
# A PNG selected in File Manager starts Image Viewer and leaves the manager alive.
GUI-SEND-KEY: o
SERIAL: while ! /bin/toybox/grep -q 'imageviewer: window ready' /tmp/mario-wm.log; do /bin/toybox/sleep 1; done
SERIAL: /bin/toybox/pgrep filemanager >/dev/null; echo image-manager-status:$?
SERIAL-CHECK: image-manager-status:0
GUI-SEND-KEYS: meta_l,w
SERIAL: while /bin/toybox/pgrep imageviewer >/dev/null; do /bin/toybox/sleep 1; done
SERIAL: kill -TERM $(cat /tmp/fm-image-open.pid); while /bin/toybox/pgrep filemanager >/dev/null; do /bin/toybox/sleep 1; done
SERIAL: kill -TERM $(cat /tmp/mario-wm.pid); while test -e /tmp/mario-wm.started; do /bin/toybox/sleep 1; done
EXIT:
