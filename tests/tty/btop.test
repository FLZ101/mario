TIMEOUT: 10
TTY-SEND: /usr/bin/btop --version
TTY-CHECK: btop version:
TTY-SEND: /usr/bin/btop; printf 'btop exit: %s\n' "$?"
TTY-CHECK: Total:
TTY-CHECK: Cpu%
TTY-CHECK: No Ethernet data
TTY-CHECK-REGEX: \d+ +oksh +root +[1-9]\d*(?:\.\d+)?[KMGTPEZYB]
TTY-SEND-RAW: z
SLEEP: 0.2
TTY-SEND-RAW: q
TTY-CHECK-REGEX: (?m)^btop exit: 0$
