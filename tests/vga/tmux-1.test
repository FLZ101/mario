VGA-SEND-KEY: f2
VGA-CHECK: / #
VGA-SEND: TERM=linux TMUX_TMPDIR=/root/tmux-tmp tmux -L vga -f /dev/null new-session -s vga /bin/oksh
SLEEP: 2
VGA-SEND: echo PANE_ONE
VGA-CHECK: PANE_ONE
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: %
VGA-SEND: echo PANE_TWO
VGA-CHECK: PANE_TWO
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: "
VGA-SEND: echo PANE_THREE
VGA-CHECK: PANE_THREE
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: c
VGA-SEND: echo WINDOW_TWO
VGA-CHECK: WINDOW_TWO
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: p
VGA-CHECK: PANE_ONE
VGA-CHECK: PANE_TWO
VGA-CHECK: PANE_THREE
VGA-CHECK-SCREEN: tmux-1.ppm
