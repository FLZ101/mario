VGA-SEND-KEY: f2
VGA-CHECK: / #
VGA-SEND: printf 'set -g status-right ""\n' > /tmp/tmux-vga.conf
VGA-SEND: tmux -L vga -f /tmp/tmux-vga.conf new-session -s vga /bin/oksh
SLEEP: 2
VGA-CHECK: [vga]
VGA-SEND: echo PANE_ONE
VGA-CHECK: PANE_ONE
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: %
SLEEP: 1
VGA-SEND: echo PANE_TWO
VGA-CHECK: PANE_TWO
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: "
SLEEP: 1
VGA-SEND: echo PANE_THREE
VGA-CHECK: PANE_THREE
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: c
SLEEP: 1
VGA-SEND: echo WINDOW_TWO
VGA-CHECK: WINDOW_TWO
VGA-SEND-KEY: ctrl-b
VGA-SEND-RAW: p
SLEEP: 1
VGA-CHECK: PANE_ONE
VGA-CHECK: PANE_TWO
VGA-CHECK: PANE_THREE
VGA-CHECK-NOT: server exited unexpectedly
VGA-CHECK-SCREEN: tmux-1.ppm
