RUN: export PATH=/bin/toybox:/usr/bin/ubase:/bin

RUN: dmesg > /root/dmesg.out; if grep -q 'Ramdisk(s):' /root/dmesg.out; then echo ramdisk-found; else echo ramdisk-missing; fi
CHECK: ramdisk-found

RUN: dmesg -C
RUN: dmesg > /root/dmesg.after-clear.out; if grep -q 'Ramdisk(s):' /root/dmesg.after-clear.out; then echo ramdisk-present-after-clear; else echo ramdisk-absent-after-clear; fi
CHECK: ramdisk-absent-after-clear

RUN: echo mario-kmsg-test > /dev/kmsg
RUN: dmesg > /root/dmesg.kmsg.out; if grep -q 'mario-kmsg-test' /root/dmesg.kmsg.out; then echo kmsg-write-found; else echo kmsg-write-missing; fi
CHECK: kmsg-write-found

RUN: dmesg -C
RUN: echo mario-kmsg-read-test > /dev/kmsg
RUN: cat /dev/kmsg > /root/kmsg.read.out & pid=$!; sleep 1; kill $pid; wait $pid 2>/dev/null; echo kmsg-read-done
RUN: cat /root/kmsg.read.out
CHECK: kmsg-read-done
CHECK: mario-kmsg-read-test

RUN: echo '<3>mario-kmsg-err' > /dev/kmsg
RUN: dmesg -r > /root/dmesg.prio.out; if grep -q '<3>mario-kmsg-err' /root/dmesg.prio.out; then echo prio-ok; else echo prio-missing; fi
CHECK: prio-ok

RUN: dmesg -C
RUN: echo '<3>mario-filter-err' > /dev/kmsg
RUN: echo '<6>mario-filter-info' > /dev/kmsg
RUN: dmesg -r > /root/dmesg.filter.out; grep '^<3>' /root/dmesg.filter.out > /root/dmesg.filter.err.out; if grep -q 'mario-filter-err' /root/dmesg.filter.err.out; then echo filter-err-ok; else echo filter-err-missing; fi
RUN: if grep -q 'mario-filter-info' /root/dmesg.filter.err.out; then echo filter-info-leaked; else echo filter-info-excluded; fi
RUN: if grep -q '<6>mario-filter-info' /root/dmesg.filter.out; then echo filter-info-stored; else echo filter-info-missing; fi
CHECK: filter-err-ok
CHECK: filter-info-excluded
CHECK: filter-info-stored

RUN: dmesg -n 4; echo dmesg-level-accepted
CHECK: dmesg-level-accepted
