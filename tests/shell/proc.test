RUN: export PATH=/bin/toybox:/bin

RUN: ls /
CHECK: proc

RUN: cat /proc/version
CHECK: Mario OS version 1.0

RUN: cat /proc/uptime
CHECK-REGEX: [0-9]+\.[0-9]{2} 0\.00

RUN: cat /proc/stat
CHECK-REGEX: (?m)^cpu [0-9]+ 0 [0-9]+ [0-9]+
CHECK-REGEX: (?m)^cpu0 [0-9]+ 0 [0-9]+ [0-9]+

RUN: [ "$(grep -c '^cpu[0-9]' /proc/stat)" -eq "$(grep -c '^processor' /proc/cpuinfo)" ] && echo proc-stat-cpus-ok
CHECK: proc-stat-cpus-ok

RUN: cpu_ticks() { read label user nice system idle rest < /proc/stat; echo "$((user + nice + system))"; }
RUN: before=$(cpu_ticks); yes >/dev/null & worker=$!; sleep 1; after=$(cpu_ticks); kill "$worker"; wait "$worker" 2>/dev/null; [ "$after" -gt "$before" ] && echo proc-stat-busy-ok
CHECK: proc-stat-busy-ok

RUN: set -- $(grep '^MemTotal:' /proc/meminfo); total=$2; set -- $(grep '^MemFree:' /proc/meminfo); [ "$2" -gt 0 ] && [ "$2" -lt "$total" ] && echo proc-meminfo-ok
CHECK: proc-meminfo-ok

RUN: cat /proc/self/status
CHECK-REGEX: Uid:\s+0\s+0\s+0\s+0
CHECK-REGEX: Name:\s+\S+
CHECK-REGEX: VmSize:\s+[1-9][0-9]* kB
CHECK-REGEX: VmRSS:\s+[1-9][0-9]* kB

RUN: cat /proc/1/comm
CHECK: init.exe

RUN: cat /proc/mounts
CHECK: mariofs / mariofs rw 0 0

RUN: mount
CHECK: proc on /proc type proc (rw)

RUN: readlink /proc/self
CHECK-REGEX: /proc/[0-9]+

RUN: readlink /proc/self/fd/0
CHECK: /dev/ttyS0

RUN: readlink /proc/self/fd/0 </dev/null
CHECK: /dev/null

RUN: readlink /proc/self/fd/0 </dev/urandom
CHECK: /dev/urandom

RUN: /usr/bin/python -c 'import os, pty; m, s = pty.openpty(); print(os.readlink(f"/proc/self/fd/{m}"), os.readlink(f"/proc/self/fd/{s}"), os.ttyname(s)); os.close(m); os.close(s)'
CHECK-REGEX: (?m)^/dev/ptmx (/dev/pts/[0-9]+) \1$

RUN: ls /proc
CHECK: mounts
CHECK: self
CHECK: uptime
CHECK: version

RUN: cd / && ls proc/ > /dev/null; echo ls-proc-relative:$?
CHECK: ls-proc-relative:0

RUN: ls /proc/self
CHECK: fd

RUN: ls /proc/self/fd > /dev/null; echo proc-fd-list:$?
CHECK: proc-fd-list:0

RUN: test -d /proc/self/fd; echo proc-fd-dir:$?
CHECK: proc-fd-dir:0

RUN: umount /proc; echo proc-umount:$?
CHECK: proc-umount:0
RUN: mount -t proc proc /proc; echo proc-remount:$?
CHECK: proc-remount:0
RUN: cat /proc/version
CHECK: Mario OS version 1.0
