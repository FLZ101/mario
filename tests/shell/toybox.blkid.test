# Exercise every blkid output and selection mode against the GPT ext2/vfat
# test partitions, plus the no-argument /proc/partitions scan.
REQUIRES-HD:
TIMEOUT: 60

RUN: export PATH=/bin/toybox:/bin

RUN: blkid -o value -s TYPE /dev/hdc3; echo type-status:$?
CHECK: ext2
CHECK: type-status:0

RUN: blkid -o value -s UUID /dev/hdc3
CHECK: 6c19814f-35fc-4013-968f-a93059ad8f31

RUN: blkid /dev/hdc3
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: blkid -o full /dev/hdc3
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: blkid -o value /dev/hdc3
CHECK: 6c19814f-35fc-4013-968f-a93059ad8f31
CHECK: ext2

RUN: blkid -o export /dev/hdc3
CHECK: DEVNAME=/dev/hdc3
CHECK: UUID=6c19814f-35fc-4013-968f-a93059ad8f31
CHECK: TYPE=ext2

RUN: blkid -o export -s UUID -s TYPE /dev/hdc3
CHECK: UUID=6c19814f-35fc-4013-968f-a93059ad8f31
CHECK: TYPE=ext2

RUN: blkid -s UUID /dev/hdc3
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+"

RUN: blkid -s TYPE /dev/hdc3
CHECK-REGEX: /dev/hdc3: TYPE="ext2"

RUN: blkid -s UUID -s TYPE /dev/hdc3
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: blkid -o value -s UUID -s TYPE /dev/hdc3
CHECK: 6c19814f-35fc-4013-968f-a93059ad8f31
CHECK: ext2

RUN: blkid -o value -s SEC_TYPE -s UUID /dev/hdc1
CHECK: msdos
CHECK: 881D-8D95

RUN: blkid /dev/hdc3 /dev/hdc4
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"
CHECK-REGEX: /dev/hdc4: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: /bin/sbase/dd if=/dev/hdc3 of=/root/blkid-head.img bs=512 count=8 2>/dev/null; blkid - < /root/blkid-head.img
CHECK-REGEX: -: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: blkid -U 881D-8D95; echo uuid-lookup-status:$?
CHECK: /dev/hdc1
CHECK: uuid-lookup-status:0

RUN: blkid -U no-such-uuid; echo uuid-miss-status:$?
CHECK: uuid-miss-status:2

RUN: blkid -U; echo uuid-scan-status:$?
CHECK: 6c19814f-35fc-4013-968f-a93059ad8f31
CHECK: uuid-scan-status:2

RUN: blkid -L no-such-label; echo label-miss-status:$?
CHECK: label-miss-status:2

RUN: blkid -L; echo label-scan-status:$?
CHECK: label-scan-status:2

RUN: blkid -o bogus /dev/hdc3; echo invalid-o-status:$?
CHECK: invalid-o-status:1

RUN: blkid
CHECK: /dev/hdc1: SEC_TYPE="msdos" UUID="881D-8D95" TYPE="vfat"
CHECK: /dev/hdc3: UUID="6c19814f-35fc-4013-968f-a93059ad8f31" TYPE="ext2"
CHECK: /dev/hdc4: UUID="50f854af-ceba-4caf-a7d6-9b354cc09294" TYPE="ext2"
