# Exercise every blkid output and selection mode against the GPT ext2/vfat
# test partitions, plus the no-argument /proc/partitions scan.
REQUIRES-HD:
TIMEOUT: 60

RUN: export PATH=/bin/toybox:/bin

RUN: blkid -o value -s TYPE /dev/hdc3; echo type-status:$?
CHECK: ext2
CHECK: type-status:0

RUN: blkid -o value -s UUID /dev/hdc3
CHECK-REGEX: [0-9a-fA-F]{8}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{12}

RUN: blkid /dev/hdc3
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: blkid -o full /dev/hdc3
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: blkid -o export /dev/hdc3
CHECK: DEVNAME=/dev/hdc3
CHECK-REGEX: UUID=[0-9a-f-]+
CHECK: TYPE=ext2

RUN: blkid -o value -s SEC_TYPE -s UUID /dev/hdc1
CHECK: msdos
CHECK-REGEX: [0-9a-fA-F]{4}\-[0-9a-fA-F]{4}

RUN: blkid /dev/hdc3 /dev/hdc4
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"
CHECK-REGEX: /dev/hdc4: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: /bin/sbase/dd if=/dev/hdc3 of=/root/blkid-head.img bs=512 count=8 2>/dev/null; blkid - < /root/blkid-head.img
CHECK-REGEX: -: UUID="[0-9a-f-]+" TYPE="ext2"

RUN: uuid=$(blkid -o value -s UUID /dev/hdc1) ; blkid -U $uuid; echo uuid-lookup-status:$?
CHECK: /dev/hdc1
CHECK: uuid-lookup-status:0

RUN: blkid
CHECK-REGEX: /dev/hdc1: SEC_TYPE="msdos" UUID="[0-9A-F-]+" TYPE="vfat"
CHECK-REGEX: /dev/hdc3: UUID="[0-9a-f-]+" TYPE="ext2"
CHECK-REGEX: /dev/hdc4: UUID="[0-9a-f-]+" TYPE="ext2"
