# Build a kernel that deliberately double-frees before scheduler and filesystem
# initialization.  This verifies that the kmalloc guard stops at the source.
REBUILD-KERNEL: selftest-kmalloc
EXPECT-HALT: Assertion 'block->magic == KMALLOC_MAGIC_ALLOC' failed
CHECK: === MARIO FATAL HANG ===
CHECK: reason: Assertion 'block->magic == KMALLOC_MAGIC_ALLOC' failed
CHECK: halted
