RUN: export PATH=/bin/toybox:/bin

# Prepare a clean workspace.
RUN: cd /root
RUN: rm -rf fs-test
RUN: mkdir -p fs-test/sub
RUN: cd fs-test
RUN: pwd
CHECK: /root/fs-test

# Create some files to work with.
RUN: echo hello > a.txt
RUN: printf 'world\n' > b.txt
RUN: touch empty.txt
RUN: seq 1 3 > nums.txt
RUN: ls -1
CHECK-REGEX: a\.txt\s+b\.txt\s+empty\.txt\s+nums\.txt\s+sub

# Inspect paths and metadata.
RUN: basename /root/fs-test/a.txt
CHECK: a.txt
RUN: dirname /root/fs-test/a.txt
CHECK: /root/fs-test
RUN: realpath a.txt
CHECK: /root/fs-test/a.txt
RUN: ln -s a.txt sym.txt
RUN: readlink sym.txt
CHECK: a.txt
RUN: stat -c '%n %s' a.txt
CHECK: a.txt 6
RUN: file a.txt
CHECK: a.txt: ASCII text
RUN: find . -name 'a.txt'
CHECK: ./a.txt
RUN: du -h a.txt
CHECK: a.txt

# Copy, move, install, and remove files.
RUN: cp a.txt copy.txt
RUN: mv copy.txt moved.txt
RUN: install -m 600 a.txt installed.txt
RUN: touch dead.txt
RUN: unlink dead.txt
RUN: ls dead.txt
CHECK: No such file or directory
RUN: ls -1
CHECK-REGEX: a\.txt\s+b\.txt\s+empty\.txt\s+installed\.txt\s+moved\.txt\s+nums\.txt\s+sub\s+sym\.txt

# Change permissions and ownership.
RUN: chmod 600 a.txt && chgrp root a.txt && chown root a.txt && echo perms-ok
CHECK: perms-ok

# Read and transform file contents.
RUN: cat a.txt
CHECK: hello
RUN: tac nums.txt
CHECK: 3
CHECK: 2
CHECK: 1
RUN: head -n 2 nums.txt
CHECK: 1
CHECK: 2
RUN: tail -n 2 nums.txt
CHECK: 2
CHECK: 3
RUN: nl nums.txt
CHECK-REGEX: 1\s+1
CHECK-REGEX: 2\s+2
CHECK-REGEX: 3\s+3
RUN: od -An -tx1 a.txt
CHECK: 68 65 6c 6c 6f 0a
RUN: xxd -p a.txt
CHECK: 68656c6c6f0a
RUN: strings a.txt
CHECK: hello
RUN: rev a.txt
CHECK: olleh
RUN: wc -l nums.txt
CHECK: 3 nums.txt
RUN: grep 2 nums.txt
CHECK: 2
RUN: egrep '1|3' nums.txt
CHECK: 1
CHECK: 3
RUN: fgrep 2 nums.txt
CHECK: 2
RUN: sed 's/hello/hi/' a.txt
CHECK: hi
RUN: cut -c1-3 a.txt
CHECK: hel
RUN: sort -r nums.txt
CHECK: 3
CHECK: 2
CHECK: 1
RUN: printf '2\n2\n' > dup.txt
RUN: uniq dup.txt
CHECK: 2
RUN: comm nums.txt nums.txt
CHECK-REGEX: \t\t1
CHECK-REGEX: \t\t2
CHECK-REGEX: \t\t3
RUN: cmp a.txt a.txt
RUN: echo $?
CHECK: 0
RUN: printf 'one\nthree\n' > left.txt
RUN: printf 'two\nfour\n' > right.txt
RUN: paste left.txt right.txt
CHECK: one	two
CHECK: three	four
RUN: printf 'a\tb\n' > tabs.txt
RUN: expand tabs.txt
CHECK-REGEX: a\s+b
RUN: fmt left.txt right.txt
CHECK: one three
CHECK: two four
RUN: echo tee | tee tee.txt
CHECK: tee
RUN: split -n 1 nums.txt part.
RUN: ls part.aa
CHECK: part.aa
RUN: printf 'a.txt\nb.txt\n' | xargs wc -l > xargs.out; echo xargs-ok
CHECK: xargs-ok
RUN: cat xargs.out
CHECK: 1 a.txt
CHECK: 1 b.txt
CHECK: 2 total

# Checksums and digests.
RUN: cksum a.txt
CHECK: 3015617425 6 a.txt
RUN: crc32 a.txt
CHECK: 363a3020
RUN: md5sum a.txt
CHECK: b1946ac92492d2347c6235b4d2611184  a.txt
RUN: sha1sum a.txt
CHECK: f572d396fae9206628714fb2ce00f72e94f2258f  a.txt
RUN: sha224sum a.txt
CHECK: 2d6d67d91d0badcdd06cbbba1fe11538a68a37ec9c2e26457ceff12b  a.txt
RUN: sha256sum a.txt
CHECK: 5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03  a.txt
RUN: sha384sum a.txt
CHECK: 1d0f284efe3edea4b9ca3bd514fa134b17eae361ccc7a1eefeff801b9bd6604e01f21f6bf249ef030599f0c218f2ba8c  a.txt
RUN: sha512sum a.txt
CHECK: e7c22b994c59d9cf2b48e549b1e24666636045930d3da7c1acb299d1c3b7f931f94aae41edda2c2b207a36e10f8bcb8d45223e54878f5b316e7ce3b6bc019629  a.txt
RUN: sha3sum a.txt
CHECK: 5093b1ea1fed43f347b4bf8f8e61334e751516506e390b0fa67758d3  a.txt

# Encode, compress, and archive files.
RUN: base64 a.txt
CHECK: aGVsbG8K
RUN: base32 a.txt
CHECK: NBSWY3DPBI======
RUN: uuencode a.txt decoded.txt > a.uu
RUN: uudecode a.uu
RUN: cmp a.txt decoded.txt
RUN: echo $?
CHECK: 0
RUN: printf 'a\r\n' | dos2unix | od -An -tx1
CHECK: 61 0a
RUN: printf 'a\n' | unix2dos | od -An -tx1
CHECK: 61 0d 0a
RUN: gzip -c a.txt > a.txt.gz
RUN: zcat a.txt.gz
CHECK: hello
RUN: gunzip -c a.txt.gz
CHECK: hello
RUN: printf '%s\n' 'QlpoOTFBWSZTWcHAgOIAAAFBAAAQAkSgADDNAMNGKZcXckU4UJDBwIDi' | base64 -d > hello.bz2
RUN: bzcat hello.bz2
CHECK: hello
RUN: bunzip2 -c hello.bz2
CHECK: hello
RUN: tar -cf archive.tar a.txt b.txt
RUN: tar -tf archive.tar
CHECK: a.txt
CHECK: b.txt
RUN: printf './a.txt\n./b.txt\n' | cpio -o > archive.cpio
RUN: cpio -t < archive.cpio
CHECK: ./a.txt
CHECK: ./b.txt

# Modify files in place.
RUN: echo one > patch.txt
RUN: printf -- '--- patch.txt\n+++ patch.txt\n@@ -1 +1 @@\n-one\n+two\n' > change.patch
RUN: patch patch.txt change.patch
CHECK: patching patch.txt
RUN: cat patch.txt
CHECK: two
RUN: printf '123456' > trunc.txt
RUN: truncate -s 3 trunc.txt
RUN: stat -c '%s' trunc.txt
CHECK: 3
RUN: echo secret > shredded.txt
RUN: shred -n 1 shredded.txt
RUN: rm shredded.txt
RUN: ls shredded.txt
CHECK: No such file or directory

# Additional supported toybox utilities.
RUN: arch
CHECK: i386
RUN: ascii | head -n 1
CHECK: Dec Hex
RUN: cal 1 2020
CHECK: January 2020
RUN: clear >/dev/null; echo clear-ok
CHECK: clear-ok
RUN: date +%Y
CHECK-REGEX: 20[0-9]{2}
RUN: env PATH=/bin/toybox:/bin true; echo env-ok
CHECK: env-ok
RUN: factor 12
CHECK: 12: 2 2 3
RUN: false; echo false-status:$?
CHECK: false-status:1
RUN: getconf PATH_MAX /
CHECK: 4096
RUN: help true
CHECK: Return zero.
RUN: kill -l 1
CHECK: HUP
RUN: killall -l 1
CHECK: SIGHUP
RUN: killall5 -l 1
CHECK: HUP
RUN: linux32 true; echo linux32-ok
CHECK: linux32-ok
RUN: logger toybox-test; echo logger-ok
CHECK: logger-ok
RUN: logname
CHECK: root
RUN: mkfifo fifo; echo mkfifo-status:$?
RUN: test -p fifo; echo fifo-mode:$?
CHECK: mkfifo-status:0
CHECK: fifo-mode:0
RUN: printf 'toybox fifo\n' > fifo & cat fifo
CHECK: toybox fifo
RUN: nice -n 7 true; echo nice-status:$?
CHECK: nice-status:0
RUN: nohup true >/dev/null 2>&1; echo nohup-ok
CHECK: nohup-ok
RUN: prlimit -n
CHECK: 256
RUN: renice -n 5 $$; echo renice-status:$?
CHECK: renice-status:0
RUN: renice -n -5 $$; echo renice-reset:$?
CHECK: renice-reset:0
RUN: sleep 0.01; echo sleep-ok
CHECK: sleep-ok
RUN: time true
CHECK: real
RUN: true; echo true-ok
CHECK: true-ok
RUN: ulimit -n
CHECK: 256
RUN: uname -s
CHECK: Mario
RUN: usleep 1000; echo usleep-ok
CHECK: usleep-ok
RUN: uuidgen
CHECK-REGEX: [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}
RUN: which cat
CHECK: /bin/toybox/cat
RUN: who; echo who-status:$?
CHECK: who-status:0
RUN: whoami
CHECK: root
RUN: yes | head -n 1
CHECK: y
RUN: [ 1 -eq 1 ]; echo bracket-ok
CHECK: bracket-ok
RUN: chroot / /bin/toybox/pwd
CHECK: /

# Unsupported toybox applets intentionally not tested:
#   hexedit: interactive editor, not suitable for this test
#   iotop, top: interactive and time out
#   link: link syscall is not implemented
#   pgrep, pkill, ps: process listing is unavailable
#   readelf: hangs on ELF files
#   timeout: fails to run its child command
#   unicode: interactive and time out

# Directory cleanup and final file tests.
RUN: rmdir sub
RUN: ls -ld sub
CHECK: No such file or directory
RUN: test -f a.txt && test -d /root/fs-test && echo test-ok
CHECK: test-ok
RUN: cd /root
RUN: test -d fs-test && echo fs-workspace-ok
CHECK: fs-workspace-ok
