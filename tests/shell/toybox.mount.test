RUN: export PATH=/bin/toybox:/bin
RUN: mount_dir=/tmp/toybox-mount; mkdir "$mount_dir"; echo mkdir-status:$?
CHECK: mkdir-status:0

# Mount rd2, whose root contains quick/brown/fox.txt.
RUN: mount -t mariofs /dev/rd2 "$mount_dir"; echo mount-status:$?
CHECK: mount-status:0

RUN: test "$(cat "$mount_dir/quick/brown/fox.txt")" = 'lazy dog'; echo mounted-content:$?
CHECK: mounted-content:0

# `mount` without arguments reads the current mount list from /proc/mounts.
RUN: mount
CHECK: /dev/rd2 on /tmp/toybox-mount type mariofs (rw)

# The same mounted rd2 must also appear in the raw /proc/mounts stream.
RUN: cat /proc/mounts
CHECK: /dev/rd2 /tmp/toybox-mount mariofs rw 0 0

# Unmount by device path and verify rd2 is no longer visible.
RUN: umount /dev/rd2; echo umount-device-status:$?
CHECK: umount-device-status:0
RUN: test ! -e "$mount_dir/quick"; echo unmounted-by-device:$?
CHECK: unmounted-by-device:0

# Remount, then unmount by mountpoint.
RUN: mount -t mariofs /dev/rd2 "$mount_dir"; echo remount-status:$?
CHECK: remount-status:0
RUN: test "$(cat "$mount_dir/quick/brown/fox.txt")" = 'lazy dog'; echo remounted-content:$?
CHECK: remounted-content:0
RUN: umount "$mount_dir"; echo umount-status:$?
CHECK: umount-status:0
RUN: test ! -e "$mount_dir/quick" && rmdir "$mount_dir"; echo unmounted-by-mountpoint:$?
CHECK: unmounted-by-mountpoint:0
