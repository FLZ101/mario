RUN: export PATH=/bin/toybox:/bin

RUN: ls /
CHECK: proc
CHECK: sys

RUN: mount
CHECK: proc on /proc type proc (rw)
CHECK: sysfs on /sys type sysfs (rw)
CHECK: debugfs on /sys/kernel/debug type debugfs (rw)

RUN: cat /proc/mounts
CHECK: proc /proc proc rw 0 0
CHECK: sysfs /sys sysfs rw 0 0
CHECK: debugfs /sys/kernel/debug debugfs rw 0 0

RUN: ls /sys
CHECK: kernel

RUN: cd / && ls sys/ > /dev/null; echo ls-sys-relative:$?
CHECK: ls-sys-relative:0

RUN: ls /sys/kernel
CHECK: debug

RUN: cd / && ls sys/kernel/ > /dev/null; echo ls-sys-kernel-relative:$?
CHECK: ls-sys-kernel-relative:0

RUN: ls /sys/kernel/debug
CHECK: syscalls
CHECK: trace_pid

RUN: cd / && ls sys/kernel/debug/ > /dev/null; echo ls-debug-relative:$?
CHECK: ls-debug-relative:0

RUN: cd /sys/kernel/debug && pwd
CHECK: /sys/kernel/debug

RUN: cd /
RUN: umount /sys/kernel/debug; echo debug-umount:$?
CHECK: debug-umount:0
RUN: umount /sys; echo sys-umount:$?
CHECK: sys-umount:0
