REQUIRES-HD:

# Writable FAT32 smoke test.  The test runner uses -snapshot for HD tests, so
# the checked-in image is not modified.

RUN: export PATH=/bin/toybox:/bin
RUN: mkdir -p /mnt
RUN: mkdir -p /tmp

RUN: mount -t vfat /dev/hdc2 /mnt; echo mount-status:$?
CHECK: mount-status:0
RUN: df /mnt; echo df-status:$?
CHECK: df-status:0
RUN: df -i /mnt; echo dfi-status:$?
CHECK: dfi-status:0

RUN: touch /mnt/wr.txt; echo touch-status:$?
CHECK: touch-status:0

RUN: echo hello > /mnt/wr.txt; echo write-status:$?
CHECK: write-status:0
RUN: cat /mnt/wr.txt; echo read-status:$?
CHECK: hello
CHECK: read-status:0

RUN: /bin/oksh - <<'EOF'
/bin/sbase/dd if=/dev/urandom of=/tmp/fat.pattern bs=4096 count=8 >/dev/null 2>&1
/bin/sbase/dd if=/tmp/fat.pattern of=/mnt/big.bin >/dev/null 2>&1
/bin/sbase/dd if=/mnt/big.bin of=/tmp/fat.back >/dev/null 2>&1
status=mismatch
if cmp /tmp/fat.pattern /tmp/fat.back; then
	status=ok
else
	status=mismatch
fi
echo "big-file:$status"
EOF
CHECK: big-file:ok

RUN: touch /mnt/m1 /mnt/m2 /mnt/m3 /mnt/m4 /mnt/m5 /mnt/m6 /mnt/m7 /mnt/m8 /mnt/m9 /mnt/m10 /mnt/m11 /mnt/m12 /mnt/m13 /mnt/m14 /mnt/m15 /mnt/m16 /mnt/m17 /mnt/m18 /mnt/m19 /mnt/m20; echo many-status:$?
CHECK: many-status:0
RUN: test -e /mnt/m20; echo many-last:$?
CHECK: many-last:0

RUN: echo abcdefghijklmnopqrstuvwxyz > /mnt/trunc.txt; truncate -s 5 /mnt/trunc.txt; cat /mnt/trunc.txt; echo truncate-status:$?
CHECK: abcde
CHECK: truncate-status:0

RUN: truncate -s 4096 /mnt/zero.bin; /bin/sbase/dd if=/dev/zero of=/tmp/zero.pat bs=4096 count=1 >/dev/null 2>&1; cmp /mnt/zero.bin /tmp/zero.pat; echo zero-status:$?
CHECK: zero-status:0

RUN: mkdir /mnt/wrdir; echo mkdir-status:$?
CHECK: mkdir-status:0
RUN: echo nested > /mnt/wrdir/n.txt; cat /mnt/wrdir/n.txt
CHECK: nested

RUN: mv /mnt/wr.txt /mnt/ren.txt; echo rename-status:$?
CHECK: rename-status:0
RUN: cat /mnt/ren.txt
CHECK: hello

# Cross-directory rename and replacement over an existing file.
RUN: mkdir -p /mnt/srcdir /mnt/dstdir; echo cross > /mnt/srcdir/from.txt; mv /mnt/srcdir/from.txt /mnt/dstdir/to.txt; cat /mnt/dstdir/to.txt; echo xdir-rename-status:$?
CHECK: cross
CHECK: xdir-rename-status:0
RUN: echo old > /mnt/dstdir/target; echo new > /mnt/dstdir/src; mv /mnt/dstdir/src /mnt/dstdir/target; cat /mnt/dstdir/target
CHECK: new

# A moved directory's .. entry must follow it to the new parent.
RUN: mkdir -p /mnt/fromdir/child /mnt/todir; echo childdata > /mnt/fromdir/child/f.txt; echo target-parent > /mnt/todir/sparent.txt; echo old-parent > /mnt/fromdir/sparent.txt; mv /mnt/fromdir/child /mnt/todir/mvd; cat /mnt/todir/mvd/f.txt; echo dir-rename-status:$?
CHECK: childdata
CHECK: dir-rename-status:0
RUN: cat /mnt/todir/mvd/../sparent.txt
CHECK: target-parent
RUN: rm /mnt/dstdir/to.txt /mnt/dstdir/target /mnt/todir/sparent.txt /mnt/todir/mvd/f.txt /mnt/fromdir/sparent.txt; echo rename-rm:$?
CHECK: rename-rm:0
RUN: rmdir /mnt/srcdir /mnt/dstdir /mnt/todir/mvd /mnt/todir /mnt/fromdir; echo rename-clean:$?
CHECK: rename-clean:0

# Long file names are encoded with LFN entries and remain discoverable after
# create, rename, read, unlink, and rmdir.
RUN: echo long > /mnt/long-file-name-for-vfat.txt; cat /mnt/long-file-name-for-vfat.txt; echo lfn-create:$?
CHECK: long
CHECK: lfn-create:0
RUN: mv /mnt/long-file-name-for-vfat.txt /mnt/longer-renamed-file-name.txt; cat /mnt/longer-renamed-file-name.txt; echo lfn-rename:$?
CHECK: long
CHECK: lfn-rename:0
RUN: ls -la /mnt; echo before-longdir-ls:$?
CHECK: before-longdir-ls:0
RUN: mkdir /mnt/longdir-for-vfat-test; echo lfn-mkdir:$?
CHECK: lfn-mkdir:0
RUN: echo nested > /mnt/longdir-for-vfat-test/data.txt; echo lfn-file:$?
CHECK: lfn-file:0
RUN: echo nested > /tmp/lfn.expect; cat /mnt/longdir-for-vfat-test/data.txt > /tmp/lfn.cat; cmp /tmp/lfn.cat /tmp/lfn.expect; echo lfn-content:$?
CHECK: lfn-content:0
RUN: ls -la /mnt; ls -la /mnt/longdir-for-vfat-test; echo lfn-ls:$?
CHECK: lfn-ls:0
RUN: rm /mnt/longdir-for-vfat-test/data.txt /mnt/longer-renamed-file-name.txt; echo lfn-rm:$?
CHECK: lfn-rm:0
RUN: rmdir /mnt/longdir-for-vfat-test; echo lfn-clean:$?
CHECK: lfn-clean:0

# Force a directory past one cluster and verify that LFN entries remain
# discoverable while deleting files across the expanded chain.
RUN: mkdir /mnt/lfn-multi; for i in 1 2 3 4 5 6 7 8; do echo data$i > /mnt/lfn-multi/long-name-file-$i.txt; done; echo lfn-multi-fill:$?
CHECK: lfn-multi-fill:0
RUN: cat /mnt/lfn-multi/long-name-file-8.txt; echo lfn-multi-read:$?
CHECK: data8
CHECK: lfn-multi-read:0
RUN: for i in 1 2 3 4 5 6 7 8; do rm /mnt/lfn-multi/long-name-file-$i.txt; done; rmdir /mnt/lfn-multi; echo lfn-multi-clean:$?
CHECK: lfn-multi-clean:0

RUN: rm /mnt/ren.txt; test ! -e /mnt/ren.txt; echo unlink-status:$?
CHECK: unlink-status:0
RUN: rm /mnt/wrdir/n.txt; rmdir /mnt/wrdir; echo rmdir-status:$?
CHECK: rmdir-status:0
RUN: rm /mnt/trunc.txt; echo truncate-unlink-status:$?
CHECK: truncate-unlink-status:0
RUN: rm /mnt/zero.bin; echo zero-unlink-status:$?
CHECK: zero-unlink-status:0
RUN: rm /mnt/big.bin; echo big-unlink-status:$?
CHECK: big-unlink-status:0
RUN: rm /mnt/m1 /mnt/m2 /mnt/m3 /mnt/m4 /mnt/m5 /mnt/m6 /mnt/m7 /mnt/m8 /mnt/m9 /mnt/m10 /mnt/m11 /mnt/m12 /mnt/m13 /mnt/m14 /mnt/m15 /mnt/m16 /mnt/m17 /mnt/m18 /mnt/m19 /mnt/m20; echo many-unlink-status:$?
CHECK: many-unlink-status:0

RUN: umount /mnt; echo umount-status:$?
CHECK: umount-status:0

RUN: mount -t vfat -o ro /dev/hdc2 /mnt; echo ro-mount-status:$?
CHECK: ro-mount-status:0
RUN: touch /mnt/ro-test; echo ro-write-status:$?
CHECK: ro-write-status:1
RUN: test ! -e /mnt/ro-test; echo ro-reject-status:$?
CHECK: ro-reject-status:0
RUN: umount /mnt; echo ro-umount-status:$?
CHECK: ro-umount-status:0
